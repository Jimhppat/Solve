{
  // 黑匣子日志级别。修改级别值并保存后约 1 秒内生效，无需重启。
  // 可选级别（由详到简）：Verbose、Debug、Information、Warning、Error、Fatal
  //
  // 本文件只能调整级别；日志写到哪里、如何写盘由程序固定，不能在此修改。
  // 启动时文件损坏或级别写错：本次运行使用默认级别，原因写入日志；运行中改错：保持修改前的级别。
  "Serilog": {
    "MinimumLevel": {
      // 全局默认级别
      "Default": "Information",
      // 按来源（命名空间前缀）单独设置，优先于 Default。
      // 只有启动时已存在的条目能热生效；新增或删除条目需要重启程序。
      "Override": {
        // 串口 / TCP 通道。排查现场通信问题时改为 Debug
        "Solve.Adapters.Hardware": "Information",
        // 总线运行时与状态机。排查状态切换被拒绝等问题时改为 Debug
        "Solve.Core.Application.Buses": "Information",
        // Avalonia 界面框架自身的日志，量大，平时只收告警
        "Avalonia": "Warning"
      }
    }
  }
}
