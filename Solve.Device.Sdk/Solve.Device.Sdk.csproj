<Project Sdk="Microsoft.NET.Sdk">

    <!--
        驱动开发包（SDK）：内核与第三方驱动包之间唯一的契约。
        只依赖 .NET 基础库，不得引用任何 Solve.* 项目：驱动包只认这里的类型，内核内部怎么变都不影响已发布的驱动。
        主版本号即 SdkInfo.MajorVersion；契约出现不兼容修改时两者一起加一。
    -->
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>14</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <!--
            1.1：新增通道声明；1.2：新增命令参数声明（CommandInfo.Arguments）；1.3：新增安全状态能力（ISafeStateProvider）。
            都只加成员，已发布的 1.0–1.2 驱动包不需重新编译；用到新成员的驱动包需要主程序的 SDK 不低于该次版本。
            1.4：仿真设备（IDeviceSimulatorProvider）由可选改为必须，设备库载入时核对。类型没有变化，
            已实现仿真设备的驱动包不需重新编译；没有实现的驱动包在 1.4 起的主程序上载入失败。
        -->
        <Version>1.4.0</Version>
        <AssemblyVersion>1.0.0.0</AssemblyVersion>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);CS1591</NoWarn>
    </PropertyGroup>

</Project>
