<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Solve.Core.Domain\Solve.Core.Domain.csproj" />
    <ProjectReference Include="..\Solve.Adapters.Hardware\Solve.Adapters.Hardware.csproj" />
    <ProjectReference Include="..\Solve.Adapters.Persistence\Solve.Adapters.Persistence.csproj" />
    <ProjectReference Include="..\Solve.Desktop\Solve.Desktop.csproj" />
    <!-- 设备库加载测试的夹具：只为把示例驱动包的程序集复制到测试输出目录，测试代码不直接引用其中的类型 -->
    <ProjectReference Include="..\Sample.DriverPackage\Sample.DriverPackage.csproj" />
    <!--
        真实驱动包的仿真链路测试（DriverPackageSimulationTests）读取源码驱动库 Devicelibrary/<包标识>/ 下编译产出的驱动包。
        这里只要构建顺序：不引用程序集（ReferenceOutputAssembly=false）、不复制任何文件（Private=false），内核与测试代码都不依赖驱动
    -->
    <ProjectReference Include="..\Devicelibrary\GJ\GJ.Drivers\GJ.Drivers.csproj" ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="..\Devicelibrary\Chroma\Chroma.Drivers\Chroma.Drivers.csproj" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- 源码驱动库的位置写进程序集元数据：与测试输出目录在哪里无关（指定 artifacts 输出目录时也能找到） -->
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>DeviceLibrarySource</_Parameter1>
      <_Parameter2>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\Devicelibrary'))</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

</Project>