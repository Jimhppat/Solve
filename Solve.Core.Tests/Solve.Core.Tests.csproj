<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Solve.Core.Domain\Solve.Core.Domain.csproj" />
    <ProjectReference Include="..\Solve.Adapters.Hardware\Solve.Adapters.Hardware.csproj" />
    <ProjectReference Include="..\Solve.Adapters.Persistence\Solve.Adapters.Persistence.csproj" />
    <ProjectReference Include="..\Solve.Desktop\Solve.Desktop.csproj" />
    <!-- 设备库加载测试的夹具：只为把示例驱动包的程序集复制到测试输出目录，测试代码不直接引用其中的类型 -->
    <ProjectReference Include="..\Sample.DriverPackage\Sample.DriverPackage.csproj" />
    <!--
        不引用任何驱动项目，连只管构建顺序的引用也不加：编译内核（含测试）不编译驱动，
        否则驱动包会跟着内核重新生成，驱动库就要重新信任。驱动由 Devicelibrary/Devicelibrary.slnx 单独编译。
    -->
  </ItemGroup>

  <ItemGroup>
    <!--
        源码驱动库的位置写进程序集元数据：仿真链路测试（DriverPackageSimulationTests）与主程序一样，
        只读取这里已经编译好的驱动包。与测试输出目录在哪里无关（指定 artifacts 输出目录时也能找到）
    -->
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>DeviceLibrarySource</_Parameter1>
      <_Parameter2>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\Devicelibrary'))</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

</Project>