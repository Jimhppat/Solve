<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Solve.UI.ViewModels"
        xmlns:views="using:Solve.UI.Views"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="800"
        x:Class="Solve.UI.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Solve - 上位机工作台"
        Width="1280" Height="800"
        MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        WindowDecorations="BorderOnly"
        ExtendClientAreaToDecorationsHint="True">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Window.DataTemplates>
        <!-- 页面路由 DataTemplate 注册：根据 CurrentPage 自动呈现对应独立视图 -->
        <DataTemplate DataType="vm:MasterConsoleViewModel">
            <views:MasterConsoleView />
        </DataTemplate>
        <DataTemplate DataType="vm:BusConsoleViewModel">
            <views:BusConsoleView />
        </DataTemplate>
        <DataTemplate DataType="vm:TopologyViewModel">
            <views:TopologyView />
        </DataTemplate>
        <DataTemplate DataType="vm:RuntimeLogViewModel">
            <views:RuntimeLogView />
        </DataTemplate>
        <DataTemplate DataType="vm:SettingsViewModel">
            <views:SettingsView />
        </DataTemplate>
    </Window.DataTemplates>

    <Window.Resources>
        <!-- ReSharper disable once Xaml.RedundantResource -->
        <!-- Semi 默认在浮层展开时给内容区压一层深色遮罩；这里换成透明：仍可点击外部收起，但页面状态始终清晰可读 -->
        <SolidColorBrush x:Key="SplitViewMaskBrush" Color="Transparent" />
    </Window.Resources>

    <Window.Styles>
        <!-- 标题栏内的按钮默认会被当成拖拽区吞掉点击；工具槽位的按钮标记为 User，正常接收输入 -->
        <Style Selector="Border#TitleBar StackPanel :is(Button)">
            <Setter Property="WindowDecorationProperties.ElementRole" Value="User" />
        </Style>

        <!-- 系统按钮：46×40 直角，与 Windows 原生尺寸一致；关闭按钮悬停为危险色 -->
        <Style Selector="Button.caption">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource SemiColorText1}" />
        </Style>
        <Style Selector="Button.caption /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>
        <Style Selector="Button.caption:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SemiColorFill1}" />
        </Style>
        <Style Selector="Button.caption:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SemiColorFill2}" />
        </Style>
        <Style Selector="Button.caption.close:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SemiColorDanger}" />
        </Style>
        <Style Selector="Button.caption.close:pointerover PathIcon">
            <Setter Property="Foreground" Value="{DynamicResource SemiColorWhite}" />
        </Style>
        <Style Selector="Button.caption PathIcon">
            <Setter Property="Width" Value="12" />
            <Setter Property="Height" Value="12" />
        </Style>

        <!-- 图标栏按钮：静止时透明，只在悬停/展开时给一层浅填充 -->
        <Style Selector="ToggleButton.rail">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="ToggleButton.rail /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="ToggleButton.rail:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SemiColorFill0}" />
        </Style>
        <Style Selector="ToggleButton.rail:checked /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SemiColorFill0}" />
        </Style>
        <Style Selector="ToggleButton.rail PathIcon">
            <Setter Property="Foreground" Value="{DynamicResource SemiColorText0}" />
        </Style>

        <!-- 导航项：40 高；图标列固定 40 宽并居中 -->
        <Style Selector="ListBox.nav > ListBoxItem">
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style Selector="ListBox.nav PathIcon">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="ListBox.nav TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="4,0,0,0" />
        </Style>

        <!-- 状态指示圆点 -->
        <Style Selector="Ellipse.dot">
            <Setter Property="Width" Value="8" />
            <Setter Property="Height" Value="8" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Styles>

    <Grid>
        <!-- 主界面整体布局 -->
        <DockPanel>

            <!-- 自绘标题栏（Rider 式）：拖拽区 + 左右槽位 + Win32 系统按钮 -->
            <Border x:Name="TitleBar" DockPanel.Dock="Top" Height="40"
                    Background="{DynamicResource SemiColorFill0}"
                    BorderBrush="{DynamicResource SemiColorBorder}"
                    BorderThickness="0,0,0,1"
                    WindowDecorationProperties.ElementRole="TitleBar">
                <Grid ColumnDefinitions="56,Auto,*,Auto,Auto">

                    <!-- 应用标识 -->
                    <Border Grid.Column="0" Width="24" Height="24"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            CornerRadius="{DynamicResource SemiBorderRadiusMedium}"
                            Background="{DynamicResource SemiColorPrimary}">
                        <TextBlock Text="S" FontSize="13" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource SemiColorWhite}" />
                    </Border>

                    <TextBlock Grid.Column="1" Text="Solve" FontSize="13" FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource SemiColorText0}" />

                    <!-- 右侧工具槽位（全站最高安全级：急停） -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8"
                                VerticalAlignment="Center" Margin="0,0,16,0">
                        <Button Classes="Small Danger" Content="紧急停止"
                                Command="{Binding EmergencyStopCommand}"
                                ToolTip.Tip="对全站总线立即执行安全跳闸" />
                    </StackPanel>

                    <!-- 窗口系统按钮 -->
                    <StackPanel Grid.Column="4" Orientation="Horizontal">
                        <Button Classes="caption" ToolTip.Tip="最小化" Click="OnMinimizeClick"
                                WindowDecorationProperties.ElementRole="MinimizeButton">
                            <PathIcon Data="{DynamicResource SemiIconMinus}" />
                        </Button>
                        <Button Classes="caption" ToolTip.Tip="最大化" Click="OnMaximizeClick"
                                WindowDecorationProperties.ElementRole="MaximizeButton">
                            <Panel>
                                <PathIcon Data="{DynamicResource SemiIconMaximize2}"
                                          IsVisible="{Binding $parent[Window].WindowState, Converter={x:Static ObjectConverters.NotEqual}, ConverterParameter={x:Static WindowState.Maximized}}" />
                                <PathIcon Data="{DynamicResource SemiIconRestore}"
                                          IsVisible="{Binding $parent[Window].WindowState, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static WindowState.Maximized}}" />
                            </Panel>
                        </Button>
                        <Button Classes="caption close" ToolTip.Tip="关闭" Click="OnCloseClick"
                                WindowDecorationProperties.ElementRole="CloseButton">
                            <PathIcon Data="{DynamicResource SemiIconClose}" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 底部状态条 (Status Bar) -->
            <Border DockPanel.Dock="Bottom" Height="28"
                    Background="{DynamicResource SemiColorFill0}"
                    BorderBrush="{DynamicResource SemiColorBorder}"
                    BorderThickness="0,1,0,0"
                    Padding="16,0">
                <DockPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Ellipse Classes="dot" Fill="{Binding ModeBadgeColor}" />
                        <TextBlock FontSize="12" FontWeight="Medium"
                                   Foreground="{DynamicResource SemiColorText1}"
                                   Text="{Binding ModeText}" />
                    </StackPanel>

                    <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12"
                               Foreground="{DynamicResource SemiColorText2}"
                               Text="{Binding StatusSummaryText}" />
                </DockPanel>
            </Border>

            <!-- 侧栏与主工作台 -->
            <SplitView x:Name="Shell"
                       DisplayMode="CompactOverlay"
                       CompactPaneLength="56"
                       OpenPaneLength="240"
                       UseLightDismissOverlayMode="True"
                       PaneBackground="{DynamicResource SemiColorNavBackground}">

                <!-- 左侧图标栏 -->
                <SplitView.Pane>
                    <Border ClipToBounds="True">
                        <DockPanel Margin="8,12">
                            <Grid DockPanel.Dock="Top" Height="40" Margin="0,0,0,16"
                                  ColumnDefinitions="40,*">
                                <ToggleButton Grid.Column="0" Classes="rail"
                                              ToolTip.Tip="展开/折叠导航"
                                              IsChecked="{Binding #Shell.IsPaneOpen, Mode=TwoWay}">
                                    <PathIcon Width="16" Height="16"
                                              Data="{DynamicResource SemiIconMenu}" />
                                </ToggleButton>
                                <TextBlock Grid.Column="1" Margin="12,0,0,0"
                                           Text="Solve" FontSize="15" FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource SemiColorText0}" />
                            </Grid>

                            <ListBox Classes="nav" SelectedIndex="{Binding SelectedNavIndex}" Background="Transparent"
                                     Tapped="OnNavItemTapped">
                                <ListBoxItem ToolTip.Tip="主控台">
                                    <Grid ColumnDefinitions="40,*">
                                        <PathIcon Data="{DynamicResource SemiIconHome}" />
                                        <TextBlock Grid.Column="1" Text="主控台" />
                                    </Grid>
                                </ListBoxItem>
                                <ListBoxItem ToolTip.Tip="总线监控">
                                    <Grid ColumnDefinitions="40,*">
                                        <PathIcon Data="{DynamicResource SemiIconLink}" />
                                        <TextBlock Grid.Column="1" Text="总线监控" />
                                    </Grid>
                                </ListBoxItem>
                                <ListBoxItem ToolTip.Tip="设备拓扑">
                                    <Grid ColumnDefinitions="40,*">
                                        <PathIcon Data="{DynamicResource SemiIconComponent}" />
                                        <TextBlock Grid.Column="1" Text="设备拓扑" />
                                    </Grid>
                                </ListBoxItem>
                                <ListBoxItem ToolTip.Tip="报文诊断" IsEnabled="False">
                                    <Grid ColumnDefinitions="40,*">
                                        <PathIcon Data="{DynamicResource SemiIconActivity}" />
                                        <TextBlock Grid.Column="1" Text="报文诊断" />
                                    </Grid>
                                </ListBoxItem>
                                <ListBoxItem ToolTip.Tip="运行日志">
                                    <Grid ColumnDefinitions="40,*">
                                        <PathIcon Data="{DynamicResource SemiIconArticle}" />
                                        <TextBlock Grid.Column="1" Text="运行日志" />
                                    </Grid>
                                </ListBoxItem>
                                <ListBoxItem ToolTip.Tip="系统设置">
                                    <Grid ColumnDefinitions="40,*">
                                        <PathIcon Data="{DynamicResource SemiIconSetting}" />
                                        <TextBlock Grid.Column="1" Text="系统设置" />
                                    </Grid>
                                </ListBoxItem>
                            </ListBox>
                        </DockPanel>
                    </Border>
                </SplitView.Pane>

                <!-- 工作台内容呈现宿主：解耦为动态页面渲染 -->
                <ContentControl Content="{Binding CurrentPage}" />
            </SplitView>
        </DockPanel>
    </Grid>
</Window>
