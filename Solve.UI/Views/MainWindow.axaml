<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="800"
        x:Class="Solve.UI.Views.MainWindow"
        Title="Solve"
        Width="1280" Height="800"
        MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        WindowDecorations="BorderOnly"
        ExtendClientAreaToDecorationsHint="True">

    <Window.Resources>
        <!-- Semi 默认在浮层展开时给内容区压一层深色遮罩；监控界面下遮罩会盖住故障行，
             这里换成透明：仍可点击外部收起，但总线状态始终清晰可读 -->
        <SolidColorBrush x:Key="SplitViewMaskBrush" Color="Transparent" />
    </Window.Resources>

    <Window.Styles>
        <!-- 标题栏内的按钮默认会被当成拖拽区吞掉点击；以后放进工具槽位的按钮自动标记为 User，正常接收输入 -->
        <Style Selector="Border#TitleBar StackPanel :is(Button)">
            <Setter Property="WindowDecorationProperties.ElementRole" Value="User" />
        </Style>

        <!-- 系统按钮：46×40 直角，与 Windows 原生尺寸一致；关闭按钮悬停为危险色 -->
        <Style Selector="Button.caption">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource SemiColorText1}" />
        </Style>
        <Style Selector="Button.caption /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>
        <Style Selector="Button.caption:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SemiColorFill1}" />
        </Style>
        <Style Selector="Button.caption:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SemiColorFill2}" />
        </Style>
        <Style Selector="Button.caption.close:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SemiColorDanger}" />
        </Style>
        <Style Selector="Button.caption.close:pointerover PathIcon">
            <Setter Property="Foreground" Value="{DynamicResource SemiColorWhite}" />
        </Style>
        <Style Selector="Button.caption PathIcon">
            <Setter Property="Width" Value="12" />
            <Setter Property="Height" Value="12" />
        </Style>

        <!-- 图标栏按钮：静止时透明，只在悬停/展开时给一层浅填充，避免常驻色块抢表格的注意力 -->
        <Style Selector="ToggleButton.rail">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="ToggleButton.rail /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="ToggleButton.rail:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SemiColorFill0}" />
        </Style>
        <Style Selector="ToggleButton.rail:checked /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SemiColorFill0}" />
        </Style>
        <Style Selector="ToggleButton.rail PathIcon">
            <Setter Property="Foreground" Value="{DynamicResource SemiColorText0}" />
        </Style>

        <!-- 导航项：40 高；图标列固定 40 宽并居中，收起时图标正好落在 56 宽图标栏的中线上 -->
        <Style Selector="ListBox.nav > ListBoxItem">
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style Selector="ListBox.nav PathIcon">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="ListBox.nav TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="4,0,0,0" />
        </Style>

        <!-- 表格行：44 高、底部发丝线；表头与数据行共用同一套列宽，保证列对齐 -->
        <Style Selector="Border.row">
            <Setter Property="Height" Value="44" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="BorderBrush" Value="{DynamicResource SemiColorBorder}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>
        <Style Selector="Border.row.last">
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Border.head">
            <Setter Property="Height" Value="36" />
            <Setter Property="Background" Value="{DynamicResource SemiColorFill0}" />
        </Style>
        <Style Selector="Border.row TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource SemiColorText0}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style Selector="Border.head TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource SemiColorText2}" />
        </Style>
        <!-- 端口参数用等宽字体：波特率、IP、端口号逐位对齐，便于现场核对 -->
        <Style Selector="TextBlock.mono">
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style Selector="TextBlock.muted">
            <Setter Property="Foreground" Value="{DynamicResource SemiColorText2}" />
        </Style>
        <Style Selector="Ellipse.dot">
            <Setter Property="Width" Value="8" />
            <Setter Property="Height" Value="8" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Styles>

    <DockPanel>

        <!-- 自绘标题栏（Rider 式）：整条是拖拽区，左右两个工具槽位留给以后的按钮，
             最右侧是自绘的系统按钮，通过 ElementRole 交给 Win32 处理（保留贴靠布局、双击最大化等系统行为） -->
        <Border x:Name="TitleBar" DockPanel.Dock="Top" Height="40"
                Background="{DynamicResource SemiColorFill0}"
                BorderBrush="{DynamicResource SemiColorBorder}"
                BorderThickness="0,0,0,1"
                WindowDecorationProperties.ElementRole="TitleBar">
            <Grid ColumnDefinitions="56,Auto,*,Auto,Auto">

                <!-- 应用标识：与下方 56 宽图标栏同列对齐 -->
                <Border Grid.Column="0" Width="24" Height="24"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        CornerRadius="{DynamicResource SemiBorderRadiusMedium}"
                        Background="{DynamicResource SemiColorPrimary}">
                    <TextBlock Text="S" FontSize="13" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{DynamicResource SemiColorWhite}" />
                </Border>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Solve" FontSize="13" FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource SemiColorText0}" />
                    <!-- 左侧工具槽位：以后放工程/配置切换之类的下拉按钮 -->
                    <StackPanel x:Name="TitleBarLeftTools" Orientation="Horizontal" Spacing="4"
                                VerticalAlignment="Center" Margin="8,0,0,0" />
                </StackPanel>

                <!-- 第 2 列留空：作为拖拽区 -->

                <!-- 右侧工具槽位：以后放运行、搜索、设置之类的图标按钮 -->
                <StackPanel x:Name="TitleBarRightTools" Grid.Column="3"
                            Orientation="Horizontal" Spacing="4"
                            VerticalAlignment="Center" Margin="0,0,8,0" />

                <StackPanel Grid.Column="4" Orientation="Horizontal">
                    <Button Classes="caption" ToolTip.Tip="最小化" Click="OnMinimizeClick"
                            WindowDecorationProperties.ElementRole="MinimizeButton">
                        <PathIcon Data="{DynamicResource SemiIconMinus}" />
                    </Button>
                    <Button Classes="caption" ToolTip.Tip="最大化" Click="OnMaximizeClick"
                            WindowDecorationProperties.ElementRole="MaximizeButton">
                        <Panel>
                            <PathIcon Data="{DynamicResource SemiIconMaximize2}"
                                      IsVisible="{Binding $parent[Window].WindowState, Converter={x:Static ObjectConverters.NotEqual}, ConverterParameter={x:Static WindowState.Maximized}}" />
                            <PathIcon Data="{DynamicResource SemiIconRestore}"
                                      IsVisible="{Binding $parent[Window].WindowState, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static WindowState.Maximized}}" />
                        </Panel>
                    </Button>
                    <Button Classes="caption close" ToolTip.Tip="关闭" Click="OnCloseClick"
                            WindowDecorationProperties.ElementRole="CloseButton">
                        <PathIcon Data="{DynamicResource SemiIconClose}" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 状态栏放在 SplitView 外面：侧栏展开时也不会遮住在线/故障统计 -->
        <Border DockPanel.Dock="Bottom"
                Height="28" Padding="16,0"
                Background="{DynamicResource SemiColorNavBackground}"
                BorderBrush="{DynamicResource SemiColorBorder}"
                BorderThickness="0,1,0,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" FontSize="12"
                           Foreground="{DynamicResource SemiColorText2}"
                           Text="示例数据，尚未接入总线管理" />
                <TextBlock VerticalAlignment="Center" FontSize="12"
                           Foreground="{DynamicResource SemiColorText2}"
                           Text="共 4 条链路 · 在线 2 · 重连中 1 · 故障 1" />
            </DockPanel>
        </Border>

        <!-- 常驻 56 宽图标栏，点击左上角按钮后以浮层展开到 240 宽，不挤压内容区；点击浮层外任意处收起 -->
        <SplitView x:Name="Shell"
                   DisplayMode="CompactOverlay"
                   CompactPaneLength="56"
                   OpenPaneLength="240"
                   UseLightDismissOverlayMode="True"
                   PaneBackground="{DynamicResource SemiColorNavBackground}">

            <SplitView.Pane>
                <!-- 收起时按 56 宽裁剪，品牌名与导航文字不会溢出到内容区 -->
                <Border ClipToBounds="True">
                    <DockPanel Margin="8,12">
                        <Grid DockPanel.Dock="Top" Height="40" Margin="0,0,0,16"
                              ColumnDefinitions="40,*">
                            <ToggleButton Grid.Column="0" Classes="rail"
                                          ToolTip.Tip="展开导航"
                                          IsChecked="{Binding #Shell.IsPaneOpen, Mode=TwoWay}">
                                <PathIcon Width="16" Height="16"
                                          Data="{DynamicResource SemiIconMenu}" />
                            </ToggleButton>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0"
                                        VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="Solve" FontSize="16" FontWeight="SemiBold"
                                           Foreground="{DynamicResource SemiColorText0}" />
                                <TextBlock Text="总线上位机" FontSize="12"
                                           Foreground="{DynamicResource SemiColorText2}" />
                            </StackPanel>
                        </Grid>

                        <!-- 单个 ListBox 承载全部导航项，保证任意时刻只有一个选中项 -->
                        <ListBox Classes="nav" SelectedIndex="0" Background="Transparent">
                            <ListBoxItem ToolTip.Tip="总线">
                                <Grid ColumnDefinitions="40,*">
                                    <PathIcon Data="{DynamicResource SemiIconLink}" />
                                    <TextBlock Grid.Column="1" Text="总线" />
                                </Grid>
                            </ListBoxItem>
                            <ListBoxItem ToolTip.Tip="设备">
                                <Grid ColumnDefinitions="40,*">
                                    <PathIcon Data="{DynamicResource SemiIconServer}" />
                                    <TextBlock Grid.Column="1" Text="设备" />
                                </Grid>
                            </ListBoxItem>
                            <ListBoxItem ToolTip.Tip="报警记录">
                                <Grid ColumnDefinitions="40,*">
                                    <PathIcon Data="{DynamicResource SemiIconBell}" />
                                    <TextBlock Grid.Column="1" Text="报警记录" />
                                </Grid>
                            </ListBoxItem>
                            <ListBoxItem ToolTip.Tip="日志">
                                <Grid ColumnDefinitions="40,*">
                                    <PathIcon Data="{DynamicResource SemiIconHistory}" />
                                    <TextBlock Grid.Column="1" Text="日志" />
                                </Grid>
                            </ListBoxItem>
                            <ListBoxItem ToolTip.Tip="设置">
                                <Grid ColumnDefinitions="40,*">
                                    <PathIcon Data="{DynamicResource SemiIconSetting}" />
                                    <TextBlock Grid.Column="1" Text="设置" />
                                </Grid>
                            </ListBoxItem>
                        </ListBox>
                    </DockPanel>
                </Border>
            </SplitView.Pane>

            <!-- 内容区 -->
            <DockPanel Background="{DynamicResource SemiColorBackground0}">

                <DockPanel DockPanel.Dock="Top" Margin="24,20,24,16">
                    <!-- 运行模式常驻页头：操作员必须一眼确认当前是否会向实机下发 -->
                    <Border DockPanel.Dock="Right" VerticalAlignment="Center"
                            Padding="8,4" CornerRadius="{DynamicResource SemiBorderRadiusSmall}"
                            Background="{DynamicResource SemiColorWarningLight}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse Classes="dot" Fill="{DynamicResource SemiColorWarning}" />
                            <TextBlock Text="仿真模式" FontSize="12"
                                       Foreground="{DynamicResource SemiColorText0}" />
                        </StackPanel>
                    </Border>
                    <StackPanel Spacing="4">
                        <TextBlock Text="总线" FontSize="20" FontWeight="SemiBold"
                                   Foreground="{DynamicResource SemiColorText0}" />
                        <TextBlock Text="串口与 TCP 链路的连接状态" FontSize="12"
                                   Foreground="{DynamicResource SemiColorText2}" />
                    </StackPanel>
                </DockPanel>

                <Border Margin="24,0,24,24" VerticalAlignment="Top" ClipToBounds="True"
                        CornerRadius="{DynamicResource SemiBorderRadiusMedium}"
                        BorderBrush="{DynamicResource SemiColorBorder}"
                        BorderThickness="1">
                    <StackPanel>

                        <Border Classes="row head">
                            <Grid ColumnDefinitions="120,1.2*,1*,1.6*,1.6*">
                                <TextBlock Grid.Column="0" Text="状态" />
                                <TextBlock Grid.Column="1" Text="名称" />
                                <TextBlock Grid.Column="2" Text="类型" />
                                <TextBlock Grid.Column="3" Text="端口参数" />
                                <TextBlock Grid.Column="4" Text="说明" />
                            </Grid>
                        </Border>

                        <Border Classes="row">
                            <Grid ColumnDefinitions="120,1.2*,1*,1.6*,1.6*">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                    <Ellipse Classes="dot" Fill="{DynamicResource SemiColorSuccess}" />
                                    <TextBlock Text="已连接" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="主控柜 PLC" />
                                <TextBlock Grid.Column="2" Classes="muted" Text="串口 RS-485" />
                                <TextBlock Grid.Column="3" Classes="mono" Text="COM3 · 115200 · 8N1" />
                                <TextBlock Grid.Column="4" Classes="muted" Text="收发正常" />
                            </Grid>
                        </Border>

                        <Border Classes="row">
                            <Grid ColumnDefinitions="120,1.2*,1*,1.6*,1.6*">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                    <Ellipse Classes="dot" Fill="{DynamicResource SemiColorSuccess}" />
                                    <TextBlock Text="已连接" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="温控仪表" />
                                <TextBlock Grid.Column="2" Classes="muted" Text="串口 RS-232" />
                                <TextBlock Grid.Column="3" Classes="mono" Text="COM5 · 9600 · 8E1" />
                                <TextBlock Grid.Column="4" Classes="muted" Text="收发正常" />
                            </Grid>
                        </Border>

                        <Border Classes="row">
                            <Grid ColumnDefinitions="120,1.2*,1*,1.6*,1.6*">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                    <Ellipse Classes="dot" Fill="{DynamicResource SemiColorWarning}" />
                                    <TextBlock Text="重连中" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="视觉工位" />
                                <TextBlock Grid.Column="2" Classes="muted" Text="TCP 客户端" />
                                <TextBlock Grid.Column="3" Classes="mono" Text="192.168.10.21:502" />
                                <TextBlock Grid.Column="4" Classes="muted" Text="第 3 次重连" />
                            </Grid>
                        </Border>

                        <!-- 故障锁存：状态文字也用危险色，不只靠圆点颜色区分 -->
                        <Border Classes="row last">
                            <Grid ColumnDefinitions="120,1.2*,1*,1.6*,1.6*">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                    <Ellipse Classes="dot" Fill="{DynamicResource SemiColorDanger}" />
                                    <TextBlock Text="故障" Foreground="{DynamicResource SemiColorDanger}" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="称重模块" />
                                <TextBlock Grid.Column="2" Classes="muted" Text="TCP 客户端" />
                                <TextBlock Grid.Column="3" Classes="mono" Text="192.168.10.40:4001" />
                                <TextBlock Grid.Column="4" Text="重连次数耗尽，需人工复位" />
                            </Grid>
                        </Border>

                    </StackPanel>
                </Border>
            </DockPanel>
        </SplitView>
    </DockPanel>
</Window>
