<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="800"
        x:Class="Solve.UI.Views.MainWindow"
        Title="Solve"
        Width="1280" Height="800"
        MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen">

    <Window.Styles>
        <!-- 表格行：44 高、底部发丝线；表头与数据行共用同一套列宽，保证列对齐 -->
        <Style Selector="Border.row">
            <Setter Property="Height" Value="44" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="BorderBrush" Value="{DynamicResource SemiColorBorder}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>
        <Style Selector="Border.row.last">
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Border.head">
            <Setter Property="Height" Value="36" />
            <Setter Property="Background" Value="{DynamicResource SemiColorFill0}" />
        </Style>
        <Style Selector="Border.row TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource SemiColorText0}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style Selector="Border.head TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource SemiColorText2}" />
        </Style>
        <!-- 端口参数用等宽字体：波特率、IP、端口号逐位对齐，便于现场核对 -->
        <Style Selector="TextBlock.mono">
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style Selector="TextBlock.muted">
            <Setter Property="Foreground" Value="{DynamicResource SemiColorText2}" />
        </Style>
        <Style Selector="Ellipse.dot">
            <Setter Property="Width" Value="8" />
            <Setter Property="Height" Value="8" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Styles>

    <DockPanel>

        <!-- 状态栏 -->
        <Border DockPanel.Dock="Bottom"
                Height="28" Padding="16,0"
                Background="{DynamicResource SemiColorNavBackground}"
                BorderBrush="{DynamicResource SemiColorBorder}"
                BorderThickness="0,1,0,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" FontSize="12"
                           Foreground="{DynamicResource SemiColorText2}"
                           Text="示例数据，尚未接入总线管理" />
                <TextBlock VerticalAlignment="Center" FontSize="12"
                           Foreground="{DynamicResource SemiColorText2}"
                           Text="共 4 条链路 · 在线 2 · 重连中 1 · 故障 1" />
            </DockPanel>
        </Border>

        <!-- 侧栏导航 -->
        <Border DockPanel.Dock="Left" Width="240"
                Background="{DynamicResource SemiColorNavBackground}"
                BorderBrush="{DynamicResource SemiColorBorder}"
                BorderThickness="0,0,1,0">
            <DockPanel Margin="12,16,12,12">
                <StackPanel DockPanel.Dock="Top" Margin="8,0,8,16" Spacing="2">
                    <TextBlock Text="Solve" FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource SemiColorText0}" />
                    <TextBlock Text="总线上位机" FontSize="12"
                               Foreground="{DynamicResource SemiColorText2}" />
                </StackPanel>

                <ListBox DockPanel.Dock="Bottom" Background="Transparent">
                    <ListBoxItem Content="设置" />
                </ListBox>

                <ListBox SelectedIndex="0" Background="Transparent">
                    <ListBoxItem Content="总线" />
                    <ListBoxItem Content="设备" />
                    <ListBoxItem Content="报警记录" />
                    <ListBoxItem Content="日志" />
                </ListBox>
            </DockPanel>
        </Border>

        <!-- 内容区 -->
        <DockPanel Background="{DynamicResource SemiColorBackground0}">

            <DockPanel DockPanel.Dock="Top" Margin="24,20,24,16">
                <!-- 运行模式常驻页头：操作员必须一眼确认当前是否会向实机下发 -->
                <Border DockPanel.Dock="Right" VerticalAlignment="Center"
                        Padding="8,4" CornerRadius="{DynamicResource SemiBorderRadiusSmall}"
                        Background="{DynamicResource SemiColorWarningLight}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Ellipse Classes="dot" Fill="{DynamicResource SemiColorWarning}" />
                        <TextBlock Text="仿真模式" FontSize="12"
                                   Foreground="{DynamicResource SemiColorText0}" />
                    </StackPanel>
                </Border>
                <StackPanel Spacing="4">
                    <TextBlock Text="总线" FontSize="20" FontWeight="SemiBold"
                               Foreground="{DynamicResource SemiColorText0}" />
                    <TextBlock Text="串口与 TCP 链路的连接状态" FontSize="12"
                               Foreground="{DynamicResource SemiColorText2}" />
                </StackPanel>
            </DockPanel>

            <Border Margin="24,0,24,24" VerticalAlignment="Top" ClipToBounds="True"
                    CornerRadius="{DynamicResource SemiBorderRadiusMedium}"
                    BorderBrush="{DynamicResource SemiColorBorder}"
                    BorderThickness="1">
                <StackPanel>

                    <Border Classes="row head">
                        <Grid ColumnDefinitions="120,1.2*,1*,1.6*,1.6*">
                            <TextBlock Grid.Column="0" Text="状态" />
                            <TextBlock Grid.Column="1" Text="名称" />
                            <TextBlock Grid.Column="2" Text="类型" />
                            <TextBlock Grid.Column="3" Text="端口参数" />
                            <TextBlock Grid.Column="4" Text="说明" />
                        </Grid>
                    </Border>

                    <Border Classes="row">
                        <Grid ColumnDefinitions="120,1.2*,1*,1.6*,1.6*">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                <Ellipse Classes="dot" Fill="{DynamicResource SemiColorSuccess}" />
                                <TextBlock Text="已连接" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="主控柜 PLC" />
                            <TextBlock Grid.Column="2" Classes="muted" Text="串口 RS-485" />
                            <TextBlock Grid.Column="3" Classes="mono" Text="COM3 · 115200 · 8N1" />
                            <TextBlock Grid.Column="4" Classes="muted" Text="收发正常" />
                        </Grid>
                    </Border>

                    <Border Classes="row">
                        <Grid ColumnDefinitions="120,1.2*,1*,1.6*,1.6*">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                <Ellipse Classes="dot" Fill="{DynamicResource SemiColorSuccess}" />
                                <TextBlock Text="已连接" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="温控仪表" />
                            <TextBlock Grid.Column="2" Classes="muted" Text="串口 RS-232" />
                            <TextBlock Grid.Column="3" Classes="mono" Text="COM5 · 9600 · 8E1" />
                            <TextBlock Grid.Column="4" Classes="muted" Text="收发正常" />
                        </Grid>
                    </Border>

                    <Border Classes="row">
                        <Grid ColumnDefinitions="120,1.2*,1*,1.6*,1.6*">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                <Ellipse Classes="dot" Fill="{DynamicResource SemiColorWarning}" />
                                <TextBlock Text="重连中" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="视觉工位" />
                            <TextBlock Grid.Column="2" Classes="muted" Text="TCP 客户端" />
                            <TextBlock Grid.Column="3" Classes="mono" Text="192.168.10.21:502" />
                            <TextBlock Grid.Column="4" Classes="muted" Text="第 3 次重连" />
                        </Grid>
                    </Border>

                    <!-- 故障锁存：状态文字也用危险色，不只靠圆点颜色区分 -->
                    <Border Classes="row last">
                        <Grid ColumnDefinitions="120,1.2*,1*,1.6*,1.6*">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                <Ellipse Classes="dot" Fill="{DynamicResource SemiColorDanger}" />
                                <TextBlock Text="故障" Foreground="{DynamicResource SemiColorDanger}" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="称重模块" />
                            <TextBlock Grid.Column="2" Classes="muted" Text="TCP 客户端" />
                            <TextBlock Grid.Column="3" Classes="mono" Text="192.168.10.40:4001" />
                            <TextBlock Grid.Column="4" Text="重连次数耗尽，需人工复位" />
                        </Grid>
                    </Border>

                </StackPanel>
            </Border>
        </DockPanel>
    </DockPanel>
</Window>
