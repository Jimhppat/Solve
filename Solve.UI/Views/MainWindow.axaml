<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Solve.UI.ViewModels"
        xmlns:views="using:Solve.UI.Views"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="800"
        x:Class="Solve.UI.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Solve - 上位机工作台"
        Width="1280" Height="800"
        MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        WindowDecorations="BorderOnly"
        ExtendClientAreaToDecorationsHint="True">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Window.DataTemplates>
        <!-- 页面路由 DataTemplate 注册：根据 CurrentPage 自动呈现对应独立视图 -->
        <DataTemplate DataType="vm:MasterConsoleViewModel">
            <views:MasterConsoleView />
        </DataTemplate>
        <DataTemplate DataType="vm:BusConsoleViewModel">
            <views:BusConsoleView />
        </DataTemplate>
        <DataTemplate DataType="vm:TopologyViewModel">
            <views:TopologyView />
        </DataTemplate>
        <DataTemplate DataType="vm:HardwareMappingViewModel">
            <views:HardwareMappingView />
        </DataTemplate>
        <DataTemplate DataType="vm:RuntimeLogViewModel">
            <views:RuntimeLogView />
        </DataTemplate>
        <DataTemplate DataType="vm:SettingsViewModel">
            <views:SettingsView />
        </DataTemplate>
    </Window.DataTemplates>

    <Window.Resources>
        <!-- ReSharper disable once Xaml.RedundantResource -->
        <!-- Semi 默认在浮层展开时给内容区压一层深色遮罩；这里换成透明：仍可点击外部收起，但页面状态始终清晰可读 -->
        <SolidColorBrush x:Key="SplitViewMaskBrush" Color="Transparent" />

        <!-- 状态栏胶囊开关的滑块颜色：仿真为蓝色系，生产为红色系（与状态圆点一致），白字在两种底色上都清晰 -->
        <LinearGradientBrush x:Key="CapsuleSimulationBrush" StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Offset="0" Color="#60A5FA" />
            <GradientStop Offset="1" Color="#2563EB" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="CapsuleProductionBrush" StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Offset="0" Color="#FB7185" />
            <GradientStop Offset="1" Color="#DC2626" />
        </LinearGradientBrush>
    </Window.Resources>

    <Window.Styles>
        <!-- 标题栏内的按钮默认会被当成拖拽区吞掉点击；工具槽位的按钮标记为 User，正常接收输入 -->
        <Style Selector="Border#TitleBar StackPanel :is(Button)">
            <Setter Property="WindowDecorationProperties.ElementRole" Value="User" />
        </Style>

        <!-- 系统按钮：46×40 直角，与 Windows 原生尺寸一致；关闭按钮悬停为危险色 -->
        <Style Selector="Button.caption">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource SemiColorText1}" />
        </Style>
        <Style Selector="Button.caption /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>
        <Style Selector="Button.caption:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SemiColorFill1}" />
        </Style>
        <Style Selector="Button.caption:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SemiColorFill2}" />
        </Style>
        <Style Selector="Button.caption.close:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SemiColorDanger}" />
        </Style>
        <Style Selector="Button.caption.close:pointerover PathIcon">
            <Setter Property="Foreground" Value="{DynamicResource SemiColorWhite}" />
        </Style>
        <Style Selector="Button.caption PathIcon">
            <Setter Property="Width" Value="12" />
            <Setter Property="Height" Value="12" />
        </Style>

        <!-- 图标栏按钮：静止时透明，只在悬停/展开时给一层浅填充 -->
        <Style Selector="ToggleButton.rail">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="ToggleButton.rail /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="ToggleButton.rail:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SemiColorFill0}" />
        </Style>
        <Style Selector="ToggleButton.rail:checked /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SemiColorFill0}" />
        </Style>
        <Style Selector="ToggleButton.rail PathIcon">
            <Setter Property="Foreground" Value="{DynamicResource SemiColorText0}" />
        </Style>

        <!-- 导航项：40 高；图标列固定 40 宽并居中 -->
        <Style Selector="ListBox.nav > ListBoxItem">
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style Selector="ListBox.nav PathIcon">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="ListBox.nav TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="4,0,0,0" />
        </Style>

        <!-- 状态指示圆点 -->
        <Style Selector="Ellipse.dot">
            <Setter Property="Width" Value="8" />
            <Setter Property="Height" Value="8" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!--
            状态栏的生产 / 仿真胶囊开关：左"仿真"、右"生产"，文字在胶囊里，滑块在两侧之间滑动并渐变变色。
            显示只读 IsModeThumbProduction（单向），点击只发出切换请求，控件本身不保存选中状态。
            宽度：2 + 54 + 54 + 2 = 112，滑块到生产一侧平移 54
        -->
        <Style Selector="Button.mode-capsule">
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <ControlTemplate>
                    <ContentPresenter Name="PART_ContentPresenter"
                                      Background="Transparent"
                                      Content="{TemplateBinding Content}" />
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.mode-capsule:disabled">
            <Setter Property="Opacity" Value="0.55" />
        </Style>
        <Style Selector="Button.mode-capsule Border.capsule-track">
            <Setter Property="Background" Value="{DynamicResource SemiColorFill1}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SemiColorBorder}" />
        </Style>
        <Style Selector="Button.mode-capsule:pointerover Border.capsule-track">
            <Setter Property="Background" Value="{DynamicResource SemiColorFill2}" />
        </Style>

        <!-- 滑块：平移 + 两层渐变交叉淡入淡出，滑动的同时颜色从仿真渐变到生产 -->
        <Style Selector="Button.mode-capsule Panel.capsule-thumb">
            <Setter Property="RenderTransform" Value="translateX(0px)" />
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.32" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.mode-capsule.production Panel.capsule-thumb">
            <Setter Property="RenderTransform" Value="translateX(54px)" />
        </Style>
        <Style Selector="Button.mode-capsule Border.thumb-layer">
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.32" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.mode-capsule Border.thumb-layer.production">
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="Button.mode-capsule.production Border.thumb-layer.production">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Button.mode-capsule.production Border.thumb-layer.simulation">
            <Setter Property="Opacity" Value="0" />
        </Style>

        <!-- 文字：滑块所在一侧为白色粗体，另一侧为次要文字色，颜色同样渐变 -->
        <Style Selector="Button.mode-capsule TextBlock.capsule-label">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource SemiColorText2}" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Foreground" Duration="0:0:0.32" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.mode-capsule:not(.production) TextBlock.capsule-label.simulation">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.mode-capsule.production TextBlock.capsule-label.production">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Styles>

    <Grid>
        <!-- 主界面整体布局 -->
        <DockPanel>

            <!-- 自绘标题栏（Rider 式）：拖拽区 + 左右槽位 + Win32 系统按钮 -->
            <Border x:Name="TitleBar" DockPanel.Dock="Top" Height="40"
                    Background="{DynamicResource SemiColorFill0}"
                    BorderBrush="{DynamicResource SemiColorBorder}"
                    BorderThickness="0,0,0,1"
                    WindowDecorationProperties.ElementRole="TitleBar">
                <Grid ColumnDefinitions="56,Auto,*,Auto,Auto">

                    <!-- 应用标识 -->
                    <Border Grid.Column="0" Width="24" Height="24"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            CornerRadius="{DynamicResource SemiBorderRadiusMedium}"
                            Background="{DynamicResource SemiColorPrimary}">
                        <TextBlock Text="S" FontSize="13" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource SemiColorWhite}" />
                    </Border>

                    <TextBlock Grid.Column="1" Text="Solve" FontSize="13" FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource SemiColorText0}" />

                    <!-- 右侧工具槽位（全站最高安全级：急停） -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8"
                                VerticalAlignment="Center" Margin="0,0,16,0">
                        <Button Classes="Small Danger" Content="紧急停止"
                                Command="{Binding EmergencyStopCommand}"
                                ToolTip.Tip="对全站总线立即执行安全跳闸" />
                    </StackPanel>

                    <!-- 窗口系统按钮 -->
                    <StackPanel Grid.Column="4" Orientation="Horizontal">
                        <Button Classes="caption" ToolTip.Tip="最小化" Click="OnMinimizeClick"
                                WindowDecorationProperties.ElementRole="MinimizeButton">
                            <PathIcon Data="{DynamicResource SemiIconMinus}" />
                        </Button>
                        <Button Classes="caption" ToolTip.Tip="最大化" Click="OnMaximizeClick"
                                WindowDecorationProperties.ElementRole="MaximizeButton">
                            <Panel>
                                <PathIcon Data="{DynamicResource SemiIconMaximize2}"
                                          IsVisible="{Binding $parent[Window].WindowState, Converter={x:Static ObjectConverters.NotEqual}, ConverterParameter={x:Static WindowState.Maximized}}" />
                                <PathIcon Data="{DynamicResource SemiIconRestore}"
                                          IsVisible="{Binding $parent[Window].WindowState, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static WindowState.Maximized}}" />
                            </Panel>
                        </Button>
                        <Button Classes="caption close" ToolTip.Tip="关闭" Click="OnCloseClick"
                                WindowDecorationProperties.ElementRole="CloseButton">
                            <PathIcon Data="{DynamicResource SemiIconClose}" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 底部状态条 (Status Bar) -->
            <Border DockPanel.Dock="Bottom" Height="28"
                    Background="{DynamicResource SemiColorFill0}"
                    BorderBrush="{DynamicResource SemiColorBorder}"
                    BorderThickness="0,1,0,0"
                    Padding="16,0">
                <DockPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Ellipse Classes="dot" Fill="{Binding ModeBadgeColor}" />
                        <TextBlock FontSize="12" FontWeight="Medium"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource SemiColorText1}"
                                   Text="{Binding ModeText}" />

                        <!-- 生产 / 仿真胶囊开关：点击只打开确认弹窗；确认中滑块先滑到目标一侧，取消后滑回实际模式 -->
                        <Button Classes="mode-capsule" Margin="8,0,0,0"
                                Classes.production="{Binding IsModeThumbProduction}"
                                Command="{Binding RequestModeToggleCommand}"
                                AutomationProperties.Name="运行模式切换"
                                ToolTip.Tip="切换生产 / 仿真模式（重启生效）">
                            <Panel Width="112" Height="22">
                                <Border Classes="capsule-track" CornerRadius="11" BorderThickness="1" />

                                <Panel Classes="capsule-thumb" Width="54" Height="18" Margin="2,0,0,0"
                                       HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <Border Classes="thumb-layer simulation" CornerRadius="9"
                                            Background="{StaticResource CapsuleSimulationBrush}"
                                            BoxShadow="0 1 3 #33000000" />
                                    <Border Classes="thumb-layer production" CornerRadius="9"
                                            Background="{StaticResource CapsuleProductionBrush}"
                                            BoxShadow="0 1 3 #33000000" />
                                </Panel>

                                <Grid ColumnDefinitions="*,*" Margin="2,0">
                                    <TextBlock Grid.Column="0" Classes="capsule-label simulation" Text="仿真" />
                                    <TextBlock Grid.Column="1" Classes="capsule-label production" Text="生产" />
                                </Grid>
                            </Panel>
                        </Button>
                    </StackPanel>

                    <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12"
                               Foreground="{DynamicResource SemiColorText2}"
                               Text="{Binding StatusSummaryText}" />
                </DockPanel>
            </Border>

            <!-- 侧栏与主工作台 -->
            <SplitView x:Name="Shell"
                       DisplayMode="CompactOverlay"
                       CompactPaneLength="56"
                       OpenPaneLength="240"
                       UseLightDismissOverlayMode="True"
                       PaneBackground="{DynamicResource SemiColorNavBackground}">

                <!-- 左侧图标栏 -->
                <SplitView.Pane>
                    <Border ClipToBounds="True">
                        <DockPanel Margin="8,12">
                            <Grid DockPanel.Dock="Top" Height="40" Margin="0,0,0,16"
                                  ColumnDefinitions="40,*">
                                <ToggleButton Grid.Column="0" Classes="rail"
                                              ToolTip.Tip="展开/折叠导航"
                                              IsChecked="{Binding #Shell.IsPaneOpen, Mode=TwoWay}">
                                    <PathIcon Width="16" Height="16"
                                              Data="{DynamicResource SemiIconMenu}" />
                                </ToggleButton>
                                <TextBlock Grid.Column="1" Margin="12,0,0,0"
                                           Text="Solve" FontSize="15" FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource SemiColorText0}" />
                            </Grid>

                            <ListBox Classes="nav" SelectedIndex="{Binding SelectedNavIndex}" Background="Transparent"
                                     Tapped="OnNavItemTapped">
                                <ListBoxItem ToolTip.Tip="主控台">
                                    <Grid ColumnDefinitions="40,*">
                                        <PathIcon Data="{DynamicResource SemiIconHome}" />
                                        <TextBlock Grid.Column="1" Text="主控台" />
                                    </Grid>
                                </ListBoxItem>
                                <ListBoxItem ToolTip.Tip="总线监控">
                                    <Grid ColumnDefinitions="40,*">
                                        <PathIcon Data="{DynamicResource SemiIconLink}" />
                                        <TextBlock Grid.Column="1" Text="总线监控" />
                                    </Grid>
                                </ListBoxItem>
                                <ListBoxItem ToolTip.Tip="设备拓扑">
                                    <Grid ColumnDefinitions="40,*">
                                        <PathIcon Data="{DynamicResource SemiIconComponent}" />
                                        <TextBlock Grid.Column="1" Text="设备拓扑" />
                                    </Grid>
                                </ListBoxItem>
                                <ListBoxItem ToolTip.Tip="硬件映射">
                                    <Grid ColumnDefinitions="40,*">
                                        <PathIcon Data="{DynamicResource SemiIconBranch}" />
                                        <TextBlock Grid.Column="1" Text="硬件映射" />
                                    </Grid>
                                </ListBoxItem>
                                <ListBoxItem ToolTip.Tip="报文诊断" IsEnabled="False">
                                    <Grid ColumnDefinitions="40,*">
                                        <PathIcon Data="{DynamicResource SemiIconActivity}" />
                                        <TextBlock Grid.Column="1" Text="报文诊断" />
                                    </Grid>
                                </ListBoxItem>
                                <ListBoxItem ToolTip.Tip="运行日志">
                                    <Grid ColumnDefinitions="40,*">
                                        <PathIcon Data="{DynamicResource SemiIconArticle}" />
                                        <TextBlock Grid.Column="1" Text="运行日志" />
                                    </Grid>
                                </ListBoxItem>
                                <ListBoxItem ToolTip.Tip="系统设置">
                                    <Grid ColumnDefinitions="40,*">
                                        <PathIcon Data="{DynamicResource SemiIconSetting}" />
                                        <TextBlock Grid.Column="1" Text="系统设置" />
                                    </Grid>
                                </ListBoxItem>
                            </ListBox>
                        </DockPanel>
                    </Border>
                </SplitView.Pane>

                <!-- 工作台内容呈现宿主：解耦为动态页面渲染 -->
                <ContentControl Content="{Binding CurrentPage}" />
            </SplitView>
        </DockPanel>

        <!-- ==================== 生产 / 仿真切换 确认弹窗 ==================== -->
        <Grid IsVisible="{Binding IsModeDialogOpen}">
            <Border Background="#80000000" />

            <Border Width="460" Margin="24"
                    VerticalAlignment="Center" HorizontalAlignment="Center"
                    Padding="24,20"
                    CornerRadius="{DynamicResource SemiBorderRadiusLarge}"
                    Background="{DynamicResource SemiColorBackground1}"
                    BorderBrush="{DynamicResource SemiColorBorder}"
                    BorderThickness="1"
                    BoxShadow="0 12 40 #33000000">
                <StackPanel Spacing="20">
                    <DockPanel>
                        <!-- 切到生产：红色警示；切到仿真：常规色 -->
                        <Panel DockPanel.Dock="Left" Width="36" Height="36" Margin="0,0,14,0" VerticalAlignment="Top">
                            <Border CornerRadius="{DynamicResource SemiBorderRadiusFull}"
                                    Background="{DynamicResource SemiColorDangerLight}"
                                    IsVisible="{Binding IsModeDialogProduction}">
                                <PathIcon Data="{DynamicResource SemiIconAlertTriangle}" Width="16" Height="16"
                                          Foreground="{DynamicResource SemiColorDanger}" />
                            </Border>
                            <Border CornerRadius="{DynamicResource SemiBorderRadiusFull}"
                                    Background="{DynamicResource SemiColorPrimaryLight}"
                                    IsVisible="{Binding !IsModeDialogProduction}">
                                <PathIcon Data="{DynamicResource SemiIconRefresh}" Width="16" Height="16"
                                          Foreground="{DynamicResource SemiColorPrimary}" />
                            </Border>
                        </Panel>
                        <StackPanel Spacing="6">
                            <TextBlock Text="{Binding ModeDialogTitle}" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource SemiColorText0}" />
                            <TextBlock Text="{Binding ModeDialogMessage}" FontSize="13" TextWrapping="Wrap"
                                       Foreground="{DynamicResource SemiColorText1}" />
                            <TextBlock Text="{Binding ModeDialogError}" FontSize="13" TextWrapping="Wrap"
                                       IsVisible="{Binding ModeDialogError, Converter={x:Static ObjectConverters.IsNotNull}}"
                                       Foreground="{DynamicResource SemiColorDanger}" />
                        </StackPanel>
                    </DockPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                        <Button Classes="Tertiary" Content="{Binding ModeDialogCancelText}"
                                Command="{Binding CancelModeSwitchCommand}" />
                        <Button Classes="Danger" Theme="{DynamicResource SolidButton}"
                                Content="切换到生产并重启"
                                Command="{Binding ConfirmModeSwitchCommand}">
                            <Button.IsVisible>
                                <MultiBinding Converter="{x:Static BoolConverters.And}">
                                    <Binding Path="IsModeDialogProduction" />
                                    <Binding Path="CanConfirmModeSwitch" />
                                </MultiBinding>
                            </Button.IsVisible>
                        </Button>
                        <Button Classes="Primary" Theme="{DynamicResource SolidButton}"
                                Content="切换到仿真并重启"
                                IsVisible="{Binding !IsModeDialogProduction}"
                                Command="{Binding ConfirmModeSwitchCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
