<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Solve.UI.ViewModels"
        xmlns:views="using:Solve.UI.Views"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="760"
        x:Class="Solve.UI.Views.DriverLibraryWindow"
        x:DataType="vm:DeviceLibraryViewModel"
        Title="驱动库"
        Width="1280" Height="800"
        MinWidth="1000" MinHeight="600"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SemiColorBackground0}">

    <!-- 驱动库窗口：全程序只有一个，非模态、从属于主窗口（见 MainWindow.OnDriverLibraryRequested），
         从任一模块配置窗口打开。Width/Height 只是取不到屏幕信息时的后备值，打开时按所在屏幕工作区的 80% 设置 -->

    <Design.DataContext>
        <vm:DeviceLibraryViewModel />
    </Design.DataContext>

    <views:DeviceLibraryView />
</Window>
