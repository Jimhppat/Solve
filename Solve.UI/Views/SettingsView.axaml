<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Solve.UI.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="700"
             x:Class="Solve.UI.Views.SettingsView"
             x:DataType="vm:SettingsViewModel"
             Background="#0D000000">
    <!-- 页面底色与卡片阴影沿用主控台与运行日志页：在主题底色上叠 5% 黑，让白卡片浮起来 -->

    <Design.DataContext>
        <vm:SettingsViewModel />
    </Design.DataContext>

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <BoxShadows x:Key="ConsolePanelShadow">0 4 16 0 #14000000, 0 0 1 0 #33000000</BoxShadows>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <BoxShadows x:Key="ConsolePanelShadow">0 4 16 0 #66000000, 0 0 0 1 #1AFFFFFF</BoxShadows>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="Border.panel">
            <Setter Property="Background" Value="{DynamicResource SemiColorBackground1}" />
            <Setter Property="CornerRadius" Value="{DynamicResource SemiBorderRadiusLarge}" />
            <Setter Property="BoxShadow" Value="{DynamicResource ConsolePanelShadow}" />
        </Style>
        <Style Selector="TextBlock.label">
            <Setter Property="Foreground" Value="{DynamicResource SemiColorText1}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- 卡片标题：标明这张卡片属于哪个模块；以后增加其他模块的设置时各占一张卡片 -->
        <Style Selector="TextBlock.section">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource SemiColorText0}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.muted">
            <Setter Property="Foreground" Value="{DynamicResource SemiColorText2}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <!-- 保存结果：成功为次要文字色，失败为危险色；必须排在 .muted 之后以覆盖其前景色 -->
        <Style Selector="TextBlock.error">
            <Setter Property="Foreground" Value="{DynamicResource SemiColorDanger}" />
        </Style>
        <Style Selector="Border.notice">
            <Setter Property="Background" Value="{DynamicResource SemiColorWarningLight}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SemiColorWarning}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource SemiBorderRadiusMedium}" />
            <Setter Property="Padding" Value="12,10" />
        </Style>
        <!-- 删除确认：同为提示框，用危险色区分（必须排在 .notice 之后以覆盖其配色） -->
        <Style Selector="Border.notice.danger">
            <Setter Property="Background" Value="{DynamicResource SemiColorDangerLight}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SemiColorDanger}" />
        </Style>
        <Style Selector="NumericUpDown.retention">
            <Setter Property="Width" Value="160" />
            <Setter Property="Increment" Value="1" />
            <Setter Property="FormatString" Value="0" />
            <Setter Property="ParsingNumberStyle" Value="Integer" />
            <Setter Property="ClipValueToMinMax" Value="True" />
        </Style>
    </UserControl.Styles>

    <Grid Margin="20" RowDefinitions="Auto,*" RowSpacing="20">

        <!-- 页面标题与保存：保存对整页设置统一生效 -->
        <Border Grid.Row="0" Classes="panel" Padding="20,10">
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right"
                        Classes="Primary" Theme="{DynamicResource SolidButton}"
                        Content="保存"
                        MinWidth="72"
                        Command="{Binding SaveCommand}"
                        ToolTip.Tip="保存全部设置，立即生效；会删除日志文件时先请你确认" />
                <TextBlock Text="{Binding PageTitle}"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource SemiColorText0}"
                           VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="20">

                <!-- 运行日志 -->
                <Border Classes="panel" Padding="20,16">
                    <StackPanel Spacing="12">

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PathIcon Data="{DynamicResource SemiIconArticle}" Width="14" Height="14"
                                      Foreground="{DynamicResource SemiColorPrimary}" />
                            <TextBlock Classes="section" Text="系统日志" />
                        </StackPanel>
                        <Border Height="1" Background="{DynamicResource SemiColorBorder}" />

                        <!-- 启动时保存的设置不可用（目录不可写、数值超出范围），本次运行改用默认值 -->
                        <Border Classes="notice" IsVisible="{Binding HasStartupFallback}">
                            <TextBlock Text="{Binding StartupFallback}"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource SemiColorText0}" />
                        </Border>

                        <Grid ColumnDefinitions="88,*,Auto,Auto" ColumnSpacing="12">
                            <TextBlock Grid.Column="0" Classes="label" Text="存储路径" />
                            <TextBox Grid.Column="1"
                                     PlaceholderText="完整路径，如 D:\SolveLogs"
                                     Text="{Binding LogDirectoryInput}"
                                     IsEnabled="{Binding IsLogSettingsAvailable}"
                                     ToolTip.Tip="{Binding CurrentLogDirectory, StringFormat='当前写入：{0}'}" />
                            <Button Grid.Column="2"
                                    Click="OnOpenDirectory"
                                    IsEnabled="{Binding IsLogSettingsAvailable}"
                                    ToolTip.Tip="在文件资源管理器中打开输入框中的目录">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <PathIcon Data="{DynamicResource SemiIconFolderOpen}" Width="12" Height="12" />
                                    <TextBlock Text="打开" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="3"
                                    Click="OnBrowseDirectory"
                                    IsEnabled="{Binding IsLogSettingsAvailable}"
                                    Content="浏览…" />
                        </Grid>

                        <!-- 保存天数与单个文件上限放在同一行：两项都是短数字，分两行会在宽屏上留下大片空白。
                             首列与「存储路径」同宽对齐；范围由视图模型给出，与 LogRetentionPolicy 一致；手输超出范围时收拢到边界 -->
                        <Grid ColumnDefinitions="88,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="12">
                            <TextBlock Grid.Column="0" Classes="label" Text="保存天数" />
                            <NumericUpDown Grid.Column="1"
                                           Classes="retention"
                                           Value="{Binding RetentionDaysInput}"
                                           Minimum="{Binding MinRetentionDays}"
                                           Maximum="{Binding MaxRetentionDays}"
                                           IsEnabled="{Binding IsLogSettingsAvailable}" />
                            <TextBlock Grid.Column="2" Classes="label" Text="天" />
                            <TextBlock Grid.Column="3" Classes="label" Text="单个文件上限" Margin="28,0,0,0" />
                            <NumericUpDown Grid.Column="4"
                                           Classes="retention"
                                           Value="{Binding FileSizeLimitMegabytesInput}"
                                           Minimum="{Binding MinFileSizeLimitMegabytes}"
                                           Maximum="{Binding MaxFileSizeLimitMegabytes}"
                                           IsEnabled="{Binding IsLogSettingsAvailable}" />
                            <TextBlock Grid.Column="5" Classes="label" Text="MB" />
                        </Grid>

                        <!-- 新设置会删除日志文件：列出个数、日期与大小，确认后才保存；确认前改动输入会取消这次保存 -->
                        <Border Classes="notice danger" IsVisible="{Binding IsAwaitingConfirmation}">
                            <StackPanel Spacing="10">
                                <TextBlock Text="{Binding PendingDeletionText}"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource SemiColorText0}" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Classes="Danger" Theme="{DynamicResource SolidButton}"
                                            Content="删除并保存"
                                            Command="{Binding ConfirmDeletionCommand}" />
                                    <Button Content="取消" Command="{Binding CancelDeletionCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Classes="muted"
                                   Classes.error="{Binding IsSaveError}"
                                   IsVisible="{Binding HasSaveMessage}"
                                   Text="{Binding SaveMessage}" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
