<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tvm="using:Solve.UI.ViewModels.Twin"
             xmlns:tv="using:Solve.UI.Views.Twin"
             x:Class="Solve.UI.Views.Twin.LayerNodeView"
             x:DataType="tvm:LayerNodeViewModel"
             x:CompileBindings="True"
             Margin="0,3"
             Cursor="Hand"
             Tapped="OnTapped">
    <!-- 层位：铺满柜体中分到的一行。左侧层号与告警计数，右侧槽位从左到右等分宽度（货架）；摘要模式右侧画状态条 -->
    <Border CornerRadius="7"
            BorderBrush="{DynamicResource SemiColorText0}"
            BorderThickness="{Binding IsSelected, Converter={x:Static tv:TwinConverters.SelectionThickness}}">
        <Border CornerRadius="6" Padding="5" BorderThickness="1"
                BorderBrush="{Binding Worst, Converter={x:Static tv:TwinConverters.WorstBrush}}"
                Opacity="{Binding ContentOpacity}">
            <Grid ColumnDefinitions="52,*" ColumnSpacing="6">
                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center" ToolTip.Tip="{Binding SummaryText}">
                    <TextBlock Text="{Binding ShortCode}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource SemiColorText0}" />
                    <TextBlock Text="{Binding Name}"
                               IsVisible="{Binding HasName}"
                               FontSize="11"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource SemiColorText2}" />
                    <TextBlock Text="{Binding AlarmText}"
                               IsVisible="{Binding HasAlarm}"
                               FontSize="10"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource SemiColorDanger}" />
                </StackPanel>
                <ItemsControl Grid.Column="1" ItemsSource="{Binding Children}" IsVisible="{Binding IsExpanded}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                <tv:TwinStatusBar Grid.Column="1"
                                  Summary="{Binding Summary}"
                                  Height="10"
                                  MinWidth="120"
                                  VerticalAlignment="Center"
                                  IsVisible="{Binding IsSummary}" />
            </Grid>
        </Border>
    </Border>
</UserControl>
