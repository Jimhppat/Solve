<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tvm="using:Solve.UI.ViewModels.Twin"
             xmlns:tv="using:Solve.UI.Views.Twin"
             x:Class="Solve.UI.Views.Twin.LayerNodeView"
             x:DataType="tvm:LayerNodeViewModel"
             x:CompileBindings="True"
             Margin="0,5">
    <!-- 层位（只展示，不可选中）：一个带明显边框（中灰）的分区，把自己的层号和下属全部槽位包在里面，层与层之间留 10 px 空白。
         左侧是浅底色的层号栏（小圆点 = 这一层最严重的状态、名称、告警计数），竖线隔开右侧的槽位区；
         槽位从左到右等分宽度（货架）。摘要模式右侧画状态条 -->
    <Border CornerRadius="6"
            BorderThickness="1"
            BorderBrush="{DynamicResource SemiColorText3}"
            ClipToBounds="True"
            Opacity="{Binding ContentOpacity}">
        <Grid ColumnDefinitions="60,*">
            <!-- 层号栏：比槽位底色深一档的底色 + 右侧竖线，像表格的表头，明确这一行属于哪一层 -->
            <Border Grid.Column="0"
                    Background="{DynamicResource SemiColorFill1}"
                    BorderBrush="{DynamicResource SemiColorText3}"
                    BorderThickness="0,0,1,0"
                    Padding="8,6">
                <StackPanel Spacing="2" VerticalAlignment="Center" ToolTip.Tip="{Binding SummaryText}">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <Ellipse Width="8" Height="8"
                                 VerticalAlignment="Center"
                                 Fill="{Binding Worst, Converter={x:Static tv:TwinConverters.WorstBrush}}" />
                        <TextBlock Text="{Binding ShortCode}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource SemiColorText0}" />
                    </StackPanel>
                    <TextBlock Text="{Binding Name}"
                               IsVisible="{Binding HasName}"
                               FontSize="11"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource SemiColorText2}" />
                    <TextBlock Text="{Binding AlarmText}"
                               IsVisible="{Binding HasAlarm}"
                               FontSize="10"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource SemiColorDanger}" />
                </StackPanel>
            </Border>
            <ItemsControl Grid.Column="1"
                          Margin="2"
                          ItemsSource="{Binding Children}"
                          IsVisible="{Binding IsExpanded}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
            <tv:TwinStatusBar Grid.Column="1"
                              Summary="{Binding Summary}"
                              Height="10"
                              MinWidth="120"
                              Margin="10,0"
                              VerticalAlignment="Center"
                              IsVisible="{Binding IsSummary}" />
        </Grid>
    </Border>
</UserControl>
