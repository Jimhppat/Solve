<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tvm="using:Solve.UI.ViewModels.Twin"
             xmlns:tv="using:Solve.UI.Views.Twin"
             x:Class="Solve.UI.Views.Twin.SlotNodeView"
             x:DataType="tvm:SlotNodeViewModel"
             x:CompileBindings="True"
             Cursor="Hand"
             Tapped="OnTapped">
    <!-- 槽位：治具位上下排列；摘要模式只画状态条。外框 = 选中标记，内框颜色 = 最严重的状态 -->
    <Border CornerRadius="7"
            BorderBrush="{DynamicResource SemiColorText0}"
            BorderThickness="{Binding IsSelected, Converter={x:Static tv:TwinConverters.SelectionThickness}}">
        <Border CornerRadius="6" Padding="5" BorderThickness="1"
                BorderBrush="{Binding Worst, Converter={x:Static tv:TwinConverters.WorstBrush}}"
                Background="{DynamicResource SemiColorFill0}"
                Opacity="{Binding ContentOpacity}">
            <StackPanel Spacing="4">
                <DockPanel ToolTip.Tip="{Binding SummaryText}">
                    <TextBlock DockPanel.Dock="Left"
                               Text="{Binding ShortCode}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource SemiColorText1}" />
                    <TextBlock Text="{Binding Name}"
                               IsVisible="{Binding HasName}"
                               Margin="6,0,0,0"
                               FontSize="11"
                               MaxWidth="96"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource SemiColorText2}" />
                </DockPanel>
                <ItemsControl ItemsSource="{Binding Children}" IsVisible="{Binding IsExpanded}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="4" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                <tv:TwinStatusBar Summary="{Binding Summary}" Width="48" Height="8" IsVisible="{Binding IsSummary}" />
            </StackPanel>
        </Border>
    </Border>
</UserControl>
