<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tvm="using:Solve.UI.ViewModels.Twin"
             xmlns:tv="using:Solve.UI.Views.Twin"
             x:Class="Solve.UI.Views.Twin.SlotNodeView"
             x:DataType="tvm:SlotNodeViewModel"
             x:CompileBindings="True"
             Margin="2"
             Cursor="Hand"
             Tapped="OnTapped">
    <!-- 槽位：铺满层位中分到的一格，治具位上下等分高度；摘要模式画状态条与告警计数。
         外框 = 选中标记，内框颜色 = 最严重的状态 -->
    <Border CornerRadius="7"
            BorderBrush="{DynamicResource SemiColorText0}"
            BorderThickness="{Binding IsSelected, Converter={x:Static tv:TwinConverters.SelectionThickness}}">
        <Border CornerRadius="6" Padding="4" BorderThickness="1"
                BorderBrush="{Binding Worst, Converter={x:Static tv:TwinConverters.WorstBrush}}"
                Background="{DynamicResource SemiColorFill0}"
                Opacity="{Binding ContentOpacity}">
            <Grid RowDefinitions="Auto,*" RowSpacing="4">
                <DockPanel Grid.Row="0" ToolTip.Tip="{Binding SummaryText}">
                    <TextBlock DockPanel.Dock="Right"
                               Text="{Binding AlarmText}"
                               IsVisible="{Binding HasAlarm}"
                               Margin="6,0,0,0"
                               FontSize="10"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource SemiColorDanger}" />
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="{Binding ShortCode}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource SemiColorText1}" />
                        <TextBlock Text="{Binding Name}"
                                   IsVisible="{Binding HasName}"
                                   FontSize="11"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource SemiColorText2}" />
                    </StackPanel>
                </DockPanel>
                <ItemsControl Grid.Row="1" ItemsSource="{Binding Children}" IsVisible="{Binding IsExpanded}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="1" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                <tv:TwinStatusBar Grid.Row="1"
                                  Summary="{Binding Summary}"
                                  Height="8"
                                  MinWidth="40"
                                  VerticalAlignment="Center"
                                  IsVisible="{Binding IsSummary}" />
            </Grid>
        </Border>
    </Border>
</UserControl>
