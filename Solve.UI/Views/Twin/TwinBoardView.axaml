<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:tvm="using:Solve.UI.ViewModels.Twin"
             xmlns:tv="using:Solve.UI.Views.Twin"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
             x:Class="Solve.UI.Views.Twin.TwinBoardView"
             x:DataType="tvm:TwinBoardViewModel"
             x:CompileBindings="True">
    <!-- 主控台显示区：从系统根开始的六层节点，铺满整个区域。
         六层控件按视图模型类型在这里统一登记，各层控件互不引用，可单独修改 -->

    <Design.DataContext>
        <tvm:TwinBoardViewModel />
    </Design.DataContext>

    <UserControl.DataTemplates>
        <DataTemplate DataType="tvm:SystemNodeViewModel">
            <tv:SystemNodeView />
        </DataTemplate>
        <DataTemplate DataType="tvm:CabinetNodeViewModel">
            <tv:CabinetNodeView />
        </DataTemplate>
        <DataTemplate DataType="tvm:LayerNodeViewModel">
            <tv:LayerNodeView />
        </DataTemplate>
        <DataTemplate DataType="tvm:SlotNodeViewModel">
            <tv:SlotNodeView />
        </DataTemplate>
        <DataTemplate DataType="tvm:FixtureNodeViewModel">
            <tv:FixtureNodeView />
        </DataTemplate>
        <DataTemplate DataType="tvm:ProductNodeViewModel">
            <tv:ProductNodeView />
        </DataTemplate>
    </UserControl.DataTemplates>

    <!-- 纯展示面板：始终从系统根画起、一次画一个柜体，点击只选中（控制区看详情），没有路径导航与返回按钮；
         柜体切换胶囊与图例在系统标题行上（见 SystemNodeView） -->
    <DockPanel>
        <!-- 刷新出错：画面已不可信，必须让操作员看到 -->
        <Border DockPanel.Dock="Top"
                IsVisible="{Binding HasRefreshError}"
                Margin="0,0,0,12"
                Padding="12,8"
                CornerRadius="{DynamicResource SemiBorderRadiusMedium}"
                Background="{DynamicResource SemiColorDangerLight}"
                BorderBrush="{DynamicResource SemiColorDanger}"
                BorderThickness="1">
            <TextBlock Text="{Binding RefreshError}" TextWrapping="Wrap" Foreground="{DynamicResource SemiColorText0}" />
        </Border>

        <Grid>
            <!-- 铺满：可滚动区域给内容的可用空间是无限大，内容自己不知道该多大；
                 把内容的最小尺寸绑到可见区域尺寸，节点少时正好铺满，节点多到低于各层最小尺寸时才出现滚动条 -->
            <ScrollViewer x:Name="Scroller"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto">
                <ContentControl Content="{Binding Root}"
                                MinWidth="{Binding #Scroller.Viewport.Width}"
                                MinHeight="{Binding #Scroller.Viewport.Height}"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch" />
            </ScrollViewer>

            <TextBlock IsVisible="{Binding ShowEmpty}"
                       Text="{Binding EmptyText}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="13"
                       Foreground="{DynamicResource SemiColorText2}" />
        </Grid>
    </DockPanel>
</UserControl>
