<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tvm="using:Solve.UI.ViewModels.Twin"
             xmlns:tv="using:Solve.UI.Views.Twin"
             x:Class="Solve.UI.Views.Twin.FixtureNodeView"
             x:DataType="tvm:FixtureNodeViewModel"
             x:CompileBindings="True"
             Cursor="Hand"
             Tapped="OnTapped">
    <!-- 治具位：产品位按网格排列（每行列数由视图模型给出）；摘要模式只画状态条。
         外框 = 选中标记，内框颜色 = 其下最严重的状态 -->
    <Border CornerRadius="7"
            BorderBrush="{DynamicResource SemiColorText0}"
            BorderThickness="{Binding IsSelected, Converter={x:Static tv:TwinConverters.SelectionThickness}}">
        <Border CornerRadius="6" Padding="4" BorderThickness="1"
                BorderBrush="{Binding Worst, Converter={x:Static tv:TwinConverters.WorstBrush}}"
                Background="{DynamicResource SemiColorBackground1}"
                Opacity="{Binding ContentOpacity}">
            <StackPanel Spacing="3">
                <TextBlock Text="{Binding ShortCode}"
                           FontSize="11"
                           Foreground="{DynamicResource SemiColorText2}"
                           ToolTip.Tip="{Binding SummaryText}" />
                <ItemsControl ItemsSource="{Binding Children}" IsVisible="{Binding IsExpanded}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="{Binding ProductColumns}" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                <tv:TwinStatusBar Summary="{Binding Summary}" Width="56" Height="8" IsVisible="{Binding IsSummary}" />
            </StackPanel>
        </Border>
    </Border>
</UserControl>
