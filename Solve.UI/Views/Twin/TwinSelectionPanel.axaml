<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tvm="using:Solve.UI.ViewModels.Twin"
             x:Class="Solve.UI.Views.Twin.TwinSelectionPanel"
             x:DataType="tvm:TwinBoardViewModel"
             x:CompileBindings="True">
    <!-- 主控台控制区：选中产品位的信息（只有产品位可选中）。
         两套身份并列：产品位编码给人看，节点 Id 给系统用（可选中复制）；名称只在配置过时显示 -->
    <StackPanel Spacing="10">
        <StackPanel Orientation="Horizontal" Spacing="8">
            <PathIcon Data="{DynamicResource SemiIconComponent}" Width="14" Height="14"
                      Foreground="{DynamicResource SemiColorPrimary}" />
            <TextBlock Text="产品信息" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource SemiColorText0}" />
        </StackPanel>

        <TextBlock IsVisible="{Binding !HasSelection}"
                   Text="点选显示区中的产品位，在这里查看产品信息"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource SemiColorText2}" />

        <Grid IsVisible="{Binding HasSelection}"
              ColumnDefinitions="64,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
              ColumnSpacing="8" RowSpacing="8">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="产品位" FontSize="12" Foreground="{DynamicResource SemiColorText2}" />
            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedAddressText}" FontFamily="Consolas, monospace"
                       Foreground="{DynamicResource SemiColorText0}" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="名称" FontSize="12" Foreground="{DynamicResource SemiColorText2}"
                       IsVisible="{Binding HasSelectedName}" />
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedNameText}" TextWrapping="Wrap"
                       IsVisible="{Binding HasSelectedName}" Foreground="{DynamicResource SemiColorText0}" />

            <TextBlock Grid.Row="2" Grid.Column="0" Text="状态" FontSize="12" Foreground="{DynamicResource SemiColorText2}" />
            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedStateText}" FontWeight="SemiBold"
                       Foreground="{DynamicResource SemiColorText0}" />

            <TextBlock Grid.Row="3" Grid.Column="0" Text="SN" FontSize="12" Foreground="{DynamicResource SemiColorText2}" />
            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedSerialText}" FontFamily="Consolas, monospace"
                       Foreground="{DynamicResource SemiColorText0}" />

            <TextBlock Grid.Row="4" Grid.Column="0" Text="更新于" FontSize="12" Foreground="{DynamicResource SemiColorText2}" />
            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedUpdatedText}" Foreground="{DynamicResource SemiColorText0}" />

            <TextBlock Grid.Row="5" Grid.Column="0" Text="节点 Id" FontSize="12" Foreground="{DynamicResource SemiColorText2}"
                       VerticalAlignment="Center" />
            <TextBox Grid.Row="5" Grid.Column="1" IsReadOnly="True" FontFamily="Consolas, monospace" FontSize="11"
                     AutomationProperties.Name="选中产品位 Id"
                     Text="{Binding SelectedIdText, Mode=OneWay}" />
        </Grid>
    </StackPanel>
</UserControl>
