<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Solve.UI.ViewModels"
             xmlns:views="using:Solve.UI.Views"
             xmlns:twin="using:Solve.UI.Views.Twin"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="700"
             x:Class="Solve.UI.Views.MasterConsoleView"
             x:DataType="vm:MasterConsoleViewModel"
             Background="#0D000000">
    <!-- 页面底色：在主题底色上叠 5% 黑，浅色下为浅灰、深色下略压暗，白卡片才能“浮”起来 -->

    <Design.DataContext>
        <vm:MasterConsoleViewModel />
    </Design.DataContext>

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <!-- 卡片阴影：一层向下偏移的柔光（光源在上方）+ 一圈极淡的轮廓线代替边框 -->
                <ResourceDictionary x:Key="Light">
                    <BoxShadows x:Key="ConsolePanelShadow">0 4 16 0 #14000000, 0 0 1 0 #33000000</BoxShadows>
                </ResourceDictionary>
                <!-- 深色下黑色阴影不明显，加深阴影并用 1px 浅色描边勾出轮廓 -->
                <ResourceDictionary x:Key="Dark">
                    <BoxShadows x:Key="ConsolePanelShadow">0 4 16 0 #66000000, 0 0 0 1 #1AFFFFFF</BoxShadows>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- 浮起卡片：标题栏、显示区、最近日志共用。
             不设 ClipToBounds，否则阴影会被裁掉；内容靠内边距避开圆角 -->
        <Style Selector="Border.panel">
            <Setter Property="Background" Value="{DynamicResource SemiColorBackground1}" />
            <Setter Property="CornerRadius" Value="{DynamicResource SemiBorderRadiusLarge}" />
            <Setter Property="BoxShadow" Value="{DynamicResource ConsolePanelShadow}" />
        </Style>

        <!-- 自动滚动开关：Semi 的选中态是实心主色，而这个开关平时都开着，整块蓝色会一直抢视线。
             改为开启时浅主色底 + 主色图标，关闭（停在当前位置）时灰色图标 -->
        <Style Selector="ToggleButton.follow /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="{DynamicResource SemiColorText2}" />
        </Style>
        <Style Selector="ToggleButton.follow:checked /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SemiColorPrimaryLight}" />
            <Setter Property="Foreground" Value="{DynamicResource SemiColorPrimary}" />
        </Style>
    </UserControl.Styles>

    <!-- 外边距与区块间距统一 20px：既拉开卡片，也给阴影留出不被裁切的空间 -->
    <Grid Margin="20" RowDefinitions="Auto,*" RowSpacing="20">

        <!-- 顶部标题与状态栏 -->
        <Border Grid.Row="0" Classes="panel" Height="52" Padding="20,0">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Left"
                            Orientation="Horizontal"
                            Spacing="10"
                            VerticalAlignment="Center">
                    <TextBlock Text="{Binding PageTitle}"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource SemiColorText0}"
                               VerticalAlignment="Center" />
                    <Border Background="{DynamicResource SemiColorFill1}"
                            CornerRadius="{DynamicResource SemiBorderRadiusSmall}"
                            Padding="8,2"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding SystemStatusText}"
                                   FontSize="12"
                                   Foreground="{DynamicResource SemiColorText2}" />
                    </Border>
                </StackPanel>

                <!-- 右侧操作与工具按钮槽位（供后续控制台指令扩展） -->
                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <!-- 工作区：显示区 : 右栏 = 3 : 1；右栏宽度夹在 280~420px，
             窄窗时保证控件放得下，宽屏时多出的空间全部让给显示区 -->
        <Grid Grid.Row="1" ColumnSpacing="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="*" MinWidth="280" MaxWidth="420" />
            </Grid.ColumnDefinitions>

            <!-- 显示区：六层节点（系统 → 柜体 → 层位 → 槽位 → 治具位 → 产品位）的产品状态；
                 点选产品格后在格子旁弹出产品信息卡片（见 TwinBoardView） -->
            <Border Grid.Column="0" Classes="panel">
                <twin:TwinBoardView Margin="20" DataContext="{Binding Twin}" />
            </Border>

            <!-- 右栏：最近日志占满整栏高度。产品信息已改为点选产品格时弹出的卡片，右栏不再放产品信息；
                 之后若增加控制分组，可在日志上方再放一张卡片。
                 最近日志：默认显示调试以外的四类、保留最近 100 条；级别多选与自动滚动在标题行，搜索与复制请到运行日志页。
                 列表必须是有界高度的卡片的直接内容，不能放进 ScrollViewer：
                 否则列表拿到无限高度，既不能自己滚动，也失去虚拟化 -->
            <Border Grid.Column="1" Classes="panel">
                <DockPanel>
                    <!-- 标题行：右侧控件按 DockPanel 顺序从右往左排（全部 / 自动滚动 / 级别），标题占剩余宽度。
                         控件统一 32 高（Semi 按钮的默认最小高度，触屏也好点）。
                         最窄 280 时标题行内宽 244：全部 50 + 开关 32 + 级别 78 + 间距 8 = 168，标题还剩约 76，
                         足够放下「最近日志」；再窄也只是标题出省略号，控件不会被挤掉。
                         底部分隔线：列表滚到底时最上面那条会被截断，有线隔开才不像排版错位 -->
                    <Border DockPanel.Dock="Top"
                            Margin="16,12,16,0"
                            Padding="4,0,0,8"
                            BorderBrush="{DynamicResource SemiColorBorder}"
                            BorderThickness="0,0,0,1">
                    <DockPanel>
                        <Button DockPanel.Dock="Right"
                                Classes="Tertiary"
                                Height="32"
                                Padding="6,0"
                                VerticalContentAlignment="Center"
                                Command="{Binding OpenRuntimeLogCommand}"
                                ToolTip.Tip="打开运行日志页，查看全部日志">
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <TextBlock Text="全部" FontSize="12" VerticalAlignment="Center" />
                                <PathIcon Data="{DynamicResource SemiIconChevronRight}" Width="10" Height="10" />
                            </StackPanel>
                        </Button>
                        <ToggleButton DockPanel.Dock="Right"
                                      Classes="follow"
                                      Width="32"
                                      Height="32"
                                      Padding="0"
                                      Margin="0,0,4,0"
                                      HorizontalContentAlignment="Center"
                                      VerticalContentAlignment="Center"
                                      IsChecked="{Binding RecentLog.AutoScroll}"
                                      ToolTip.Tip="自动滚动：开启时始终显示最新日志；关闭后停在当前位置，新日志照常追加">
                            <PathIcon Data="{DynamicResource SemiIconAlignBottom}" Width="12" Height="12" />
                        </ToggleButton>
                        <!-- 级别多选：按钮上显示简短说明（全部 / 信息+ / 警告 / 3 级…），悬停看已选全部级别；
                             浮层贴卡片右边缘向左展开，不会伸出窗口 -->
                        <DropDownButton DockPanel.Dock="Right"
                                        Width="78"
                                        Height="32"
                                        Padding="8,0,4,0"
                                        Margin="0,0,4,0"
                                        FontSize="12"
                                        HorizontalContentAlignment="Left"
                                        VerticalContentAlignment="Center"
                                        Content="{Binding RecentLog.LevelFilterText}"
                                        ToolTip.Tip="{Binding RecentLog.LevelFilterDetail}">
                            <DropDownButton.Flyout>
                                <Flyout Placement="BottomEdgeAlignedRight">
                                    <views:LevelFilterPanel DataContext="{Binding RecentLog}" />
                                </Flyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>
                        <TextBlock Text="最近日志"
                                   Margin="0,0,8,0"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource SemiColorText0}"
                                   VerticalAlignment="Center" />
                    </DockPanel>
                    </Border>
                    <views:RecentLogList DataContext="{Binding RecentLog}" Margin="8,4,8,8" />
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
