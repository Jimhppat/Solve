<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Solve.UI.ViewModels"
             xmlns:views="using:Solve.UI.Views"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="700"
             x:Class="Solve.UI.Views.MasterConsoleView"
             x:DataType="vm:MasterConsoleViewModel"
             Background="#0D000000">
    <!-- 页面底色：在主题底色上叠 5% 黑，浅色下为浅灰、深色下略压暗，白卡片才能“浮”起来 -->

    <Design.DataContext>
        <vm:MasterConsoleViewModel />
    </Design.DataContext>

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <!-- 卡片阴影：一层向下偏移的柔光（光源在上方）+ 一圈极淡的轮廓线代替边框 -->
                <ResourceDictionary x:Key="Light">
                    <BoxShadows x:Key="ConsolePanelShadow">0 4 16 0 #14000000, 0 0 1 0 #33000000</BoxShadows>
                </ResourceDictionary>
                <!-- 深色下黑色阴影不明显，加深阴影并用 1px 浅色描边勾出轮廓 -->
                <ResourceDictionary x:Key="Dark">
                    <BoxShadows x:Key="ConsolePanelShadow">0 4 16 0 #66000000, 0 0 0 1 #1AFFFFFF</BoxShadows>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- 浮起卡片：标题栏、显示区、控制区共用。
             不设 ClipToBounds，否则阴影会被裁掉；内容靠内边距避开圆角 -->
        <Style Selector="Border.panel">
            <Setter Property="Background" Value="{DynamicResource SemiColorBackground1}" />
            <Setter Property="CornerRadius" Value="{DynamicResource SemiBorderRadiusLarge}" />
            <Setter Property="BoxShadow" Value="{DynamicResource ConsolePanelShadow}" />
        </Style>
    </UserControl.Styles>

    <!-- 外边距与区块间距统一 20px：既拉开卡片，也给阴影留出不被裁切的空间 -->
    <Grid Margin="20" RowDefinitions="Auto,*" RowSpacing="20">

        <!-- 顶部标题与状态栏 -->
        <Border Grid.Row="0" Classes="panel" Height="52" Padding="20,0">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Left"
                            Orientation="Horizontal"
                            Spacing="10"
                            VerticalAlignment="Center">
                    <TextBlock Text="{Binding PageTitle}"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource SemiColorText0}"
                               VerticalAlignment="Center" />
                    <Border Background="{DynamicResource SemiColorFill1}"
                            CornerRadius="{DynamicResource SemiBorderRadiusSmall}"
                            Padding="8,2"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding SystemStatusText}"
                                   FontSize="12"
                                   Foreground="{DynamicResource SemiColorText2}" />
                    </Border>
                </StackPanel>

                <!-- 右侧操作与工具按钮槽位（供后续控制台指令扩展） -->
                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <!-- 工作区：显示区 : 控制区 = 3 : 1；控制区宽度夹在 280~420px，
             窄窗时保证控件放得下，宽屏时多出的空间全部让给显示区 -->
        <Grid Grid.Row="1" ColumnSpacing="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="*" MinWidth="280" MaxWidth="420" />
            </Grid.ColumnDefinitions>

            <!-- 显示区：仪表、曲线、图表等实时监视内容 -->
            <Border Grid.Column="0" Classes="panel">
                <Grid Margin="20">
                    <!-- 显示内容槽位 -->
                </Grid>
            </Border>

            <!-- 右栏：控制区在上、最近日志在下，各占一张卡片，间距同为 20px。
                 右栏高度 = 窗口高度 - 180（标题栏 40、状态栏 28、页边距 40、标题卡片 52、行距 20）：
                 最小窗口 600 → 420，默认 800 → 620。
                 两行按 1:1 分配；日志至少 200（约 2~3 条）以免缩成一条缝，最多 400，更高的屏幕把多出的空间留给控制区。
                 最小窗口时 160 + 20 + 200 = 380 ≤ 420，两张卡片都不会被挤到下限以下 -->
            <Grid Grid.Column="1" RowSpacing="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="160" />
                    <RowDefinition Height="*" MinHeight="200" MaxHeight="400" />
                </Grid.RowDefinitions>

                <!-- 控制区：控制分组自上而下排列，超出高度时纵向滚动 -->
                <Border Grid.Row="0" Classes="panel">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="20" Spacing="12">
                            <!-- 控制分组槽位 -->
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- 最近日志：信息及以上、保留最近 100 条；筛选、搜索、复制请到运行日志页。
                     列表必须是有界高度的卡片的直接内容，不能放进上面的 ScrollViewer：
                     否则列表拿到无限高度，既不能自己滚动，也失去虚拟化 -->
                <Border Grid.Row="1" Classes="panel">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="20,12,12,4">
                            <Button DockPanel.Dock="Right"
                                    Classes="Tertiary"
                                    Padding="6,2"
                                    Command="{Binding OpenRuntimeLogCommand}"
                                    ToolTip.Tip="打开运行日志页，查看全部日志">
                                <StackPanel Orientation="Horizontal" Spacing="2">
                                    <TextBlock Text="全部" FontSize="12" VerticalAlignment="Center" />
                                    <PathIcon Data="{DynamicResource SemiIconChevronRight}" Width="10" Height="10" />
                                </StackPanel>
                            </Button>
                            <TextBlock Text="最近日志"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource SemiColorText0}"
                                       VerticalAlignment="Center" />
                        </DockPanel>
                        <views:RecentLogList DataContext="{Binding RecentLog}" Margin="8,0,8,8" />
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
