<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Solve.UI.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="700"
             x:Class="Solve.UI.Views.RuntimeLogView"
             x:DataType="vm:RuntimeLogViewModel"
             Background="#0D000000">
    <!-- 页面底色与卡片阴影沿用主控台：在主题底色上叠 5% 黑，让白卡片浮起来 -->

    <Design.DataContext>
        <vm:RuntimeLogViewModel />
    </Design.DataContext>

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <BoxShadows x:Key="ConsolePanelShadow">0 4 16 0 #14000000, 0 0 1 0 #33000000</BoxShadows>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <BoxShadows x:Key="ConsolePanelShadow">0 4 16 0 #66000000, 0 0 0 1 #1AFFFFFF</BoxShadows>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="Border.panel">
            <Setter Property="Background" Value="{DynamicResource SemiColorBackground1}" />
            <Setter Property="CornerRadius" Value="{DynamicResource SemiBorderRadiusLarge}" />
            <Setter Property="BoxShadow" Value="{DynamicResource ConsolePanelShadow}" />
        </Style>

        <Style Selector="TextBlock.mono">
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Courier New" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <!-- 日志行：紧凑行距；选中态沿用主题 -->
        <Style Selector="ListBox.log > ListBoxItem">
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="MinHeight" Value="0" />
        </Style>
        <Style Selector="ListBox.log TextBlock">
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>

        <!-- 级别标签：默认（信息）为中性色，警告 / 错误用主题的警告色与危险色 -->
        <Style Selector="Border.level">
            <Setter Property="CornerRadius" Value="{DynamicResource SemiBorderRadiusSmall}" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Background" Value="{DynamicResource SemiColorFill0}" />
        </Style>
        <Style Selector="Border.level > TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource SemiColorText1}" />
        </Style>
        <Style Selector="Border.level.warning">
            <Setter Property="Background" Value="{DynamicResource SemiColorWarningLight}" />
        </Style>
        <Style Selector="Border.level.warning > TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SemiColorWarning}" />
        </Style>
        <Style Selector="Border.level.error">
            <Setter Property="Background" Value="{DynamicResource SemiColorDangerLight}" />
        </Style>
        <Style Selector="Border.level.error > TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SemiColorDanger}" />
        </Style>

        <!-- 消息正文；调试 / 跟踪级别淡化，突出业务日志（后定义的样式优先） -->
        <Style Selector="TextBlock.message">
            <Setter Property="Foreground" Value="{DynamicResource SemiColorText0}" />
        </Style>
        <Style Selector="Grid.debug TextBlock.message">
            <Setter Property="Foreground" Value="{DynamicResource SemiColorText2}" />
        </Style>
    </UserControl.Styles>

    <Grid Margin="20" RowDefinitions="Auto,*" RowSpacing="20">

        <!-- 标题、统计与工具 -->
        <Border Grid.Row="0" Classes="panel" Padding="20,10">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Left"
                            Orientation="Horizontal"
                            Spacing="10"
                            VerticalAlignment="Center">
                    <TextBlock Text="{Binding PageTitle}"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource SemiColorText0}"
                               VerticalAlignment="Center" />
                    <Border Background="{DynamicResource SemiColorFill1}"
                            CornerRadius="{DynamicResource SemiBorderRadiusSmall}"
                            Padding="8,2"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding SummaryText}"
                                   FontSize="12"
                                   Foreground="{DynamicResource SemiColorText2}" />
                    </Border>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal"
                            Spacing="8"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <ComboBox Width="120"
                              ItemsSource="{Binding LevelOptions}"
                              SelectedItem="{Binding SelectedLevel}" />
                    <TextBox Width="220"
                             Classes="clearButton"
                             PlaceholderText="搜索消息或来源"
                             Text="{Binding SearchText}">
                        <TextBox.InnerLeftContent>
                            <PathIcon Data="{DynamicResource SemiIconSearch}" Width="12" Height="12" Margin="8,0,0,0"
                                      Foreground="{DynamicResource SemiColorText2}" />
                        </TextBox.InnerLeftContent>
                    </TextBox>
                    <CheckBox Content="自动滚动" IsChecked="{Binding AutoScroll}" VerticalAlignment="Center" />
                    <Button Command="{Binding ClearCommand}" ToolTip.Tip="只清空界面上的日志，日志文件不受影响">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="{DynamicResource SemiIconDelete}" Width="12" Height="12" />
                            <TextBlock Text="清空" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Click="OnOpenLogDirectory"
                            IsVisible="{Binding HasLogDirectory}"
                            ToolTip.Tip="{Binding LogDirectory}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="{DynamicResource SemiIconFolderOpen}" Width="12" Height="12" />
                            <TextBlock Text="打开日志目录" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 日志列表 -->
        <Border Grid.Row="1" Classes="panel" Padding="8">
            <Grid>
                <StackPanel IsVisible="{Binding IsEmpty}"
                            Spacing="12"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <PathIcon Data="{DynamicResource SemiIconArticle}" Width="40" Height="40"
                              Foreground="{DynamicResource SemiColorText2}" />
                    <TextBlock Text="{Binding EmptyText}" FontSize="14" FontWeight="Medium"
                               Foreground="{DynamicResource SemiColorText2}"
                               HorizontalAlignment="Center" />
                </StackPanel>

                <!-- ListBox 自带虚拟化：只为可见的行创建控件，保留 2000 条也不卡 -->
                <ListBox x:Name="LogList"
                         Classes="log"
                         Background="Transparent"
                         IsVisible="{Binding !IsEmpty}"
                         ItemsSource="{Binding Entries}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:LogEntryItem">
                            <Grid ColumnDefinitions="Auto,Auto,160,*"
                                  ColumnSpacing="12"
                                  Background="Transparent"
                                  Classes.debug="{Binding IsDebug}">
                                <Grid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="复制此条" Click="OnCopyEntry" />
                                    </ContextMenu>
                                </Grid.ContextMenu>

                                <TextBlock Grid.Column="0" Classes="mono" Text="{Binding TimeText}"
                                           Foreground="{DynamicResource SemiColorText2}" Margin="0,1,0,0" />
                                <Border Grid.Column="1" Classes="level"
                                        Classes.warning="{Binding IsWarning}"
                                        Classes.error="{Binding IsError}">
                                    <TextBlock Text="{Binding LevelText}" />
                                </Border>
                                <TextBlock Grid.Column="2" Text="{Binding SourceText}"
                                           ToolTip.Tip="{Binding Source}"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource SemiColorText2}" />
                                <StackPanel Grid.Column="3" Spacing="2">
                                    <TextBlock Classes="message" Text="{Binding Message}" TextWrapping="Wrap" />
                                    <TextBlock IsVisible="{Binding HasException}"
                                               Text="附带异常信息，悬停查看，右键可复制"
                                               ToolTip.Tip="{Binding DetailText}"
                                               FontSize="12"
                                               Foreground="{DynamicResource SemiColorDanger}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
    </Grid>
</UserControl>
