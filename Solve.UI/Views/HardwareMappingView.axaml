<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Solve.UI.ViewModels"
             xmlns:views="using:Solve.UI.Views"
             mc:Ignorable="d" d:DesignWidth="1400" d:DesignHeight="800"
             x:Class="Solve.UI.Views.HardwareMappingView"
             x:DataType="vm:HardwareMappingViewModel"
             x:CompileBindings="True"
             Background="#0D000000">
    <!-- 硬件映射页：左边位置树（一个位置即拓扑的一个节点），中间选中位置的接线，右边总线上可映射的硬件通道。
         只显示层级、位置编码、模块名与通道名，系统 Id 不显示；不放说明性小字，结果在操作后出现 -->

    <Design.DataContext>
        <vm:HardwareMappingViewModel />
    </Design.DataContext>

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <BoxShadows x:Key="ConsolePanelShadow">0 4 16 0 #14000000, 0 0 1 0 #33000000</BoxShadows>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <BoxShadows x:Key="ConsolePanelShadow">0 4 16 0 #66000000, 0 0 0 1 #1AFFFFFF</BoxShadows>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="Border.panel">
            <Setter Property="Background" Value="{DynamicResource SemiColorBackground1}" />
            <Setter Property="CornerRadius" Value="{DynamicResource SemiBorderRadiusLarge}" />
            <Setter Property="BoxShadow" Value="{DynamicResource ConsolePanelShadow}" />
        </Style>
        <Style Selector="TextBlock.section">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource SemiColorText0}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.message">
            <Setter Property="Foreground" Value="{DynamicResource SemiColorText1}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="TextBlock.error">
            <Setter Property="Foreground" Value="{DynamicResource SemiColorDanger}" />
        </Style>
        <Style Selector="Border.badge">
            <Setter Property="Background" Value="{DynamicResource SemiColorDangerLight}" />
            <Setter Property="CornerRadius" Value="{DynamicResource SemiBorderRadiusSmall}" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="ListBox.hardware > ListBoxItem">
            <Setter Property="Padding" Value="0" />
        </Style>
    </UserControl.Styles>

    <Grid Margin="20" RowDefinitions="Auto,*" RowSpacing="20">

        <Border Grid.Row="0" Classes="panel" Padding="20,10">
            <DockPanel>
                <!-- 中栏的两种用法：查看 / 编辑选中位置的接线；或映射草稿（取位置、取通道、组装、确认） -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="16">
                    <RadioButton GroupName="MappingMode" Content="按位置查看" IsChecked="{Binding IsWiringMode, Mode=OneWay}" />
                    <RadioButton GroupName="MappingMode" Content="映射草稿" IsChecked="{Binding IsDraftMode}" />
                </StackPanel>
                <TextBlock Classes="section" Text="{Binding PageTitle}" />
            </DockPanel>
        </Border>

        <!-- 未接入或尚未建档 -->
        <Border Grid.Row="1" Classes="panel" Padding="20,16" IsVisible="{Binding ShowEmpty}">
            <TextBlock Text="{Binding EmptyText}" Foreground="{DynamicResource SemiColorText1}" />
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="*,520,1.2*" ColumnSpacing="20" IsVisible="{Binding !ShowEmpty}">

            <!-- 左：位置树 -->
            <Border Grid.Column="0" Classes="panel" Padding="20,16">
                <Grid RowDefinitions="Auto,Auto,*" RowSpacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <PathIcon Data="{DynamicResource SemiIconComponent}" Width="14" Height="14"
                                  Foreground="{DynamicResource SemiColorPrimary}" />
                        <TextBlock Classes="section" Text="位置" />
                    </StackPanel>
                    <Border Grid.Row="1" Height="1" Background="{DynamicResource SemiColorBorder}" />
                    <TreeView Grid.Row="2"
                              ItemsSource="{Binding Roots}"
                              SelectedItem="{Binding SelectedItem, Mode=TwoWay}">
                        <TreeView.Styles>
                            <Style Selector="TreeViewItem" x:DataType="vm:TopologyTreeItemViewModel">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                            </Style>
                        </TreeView.Styles>
                        <TreeView.ItemTemplate>
                            <TreeDataTemplate x:DataType="vm:TopologyTreeItemViewModel" ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{Binding Header}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Name}" IsVisible="{Binding HasName}"
                                               Foreground="{DynamicResource SemiColorText2}" VerticalAlignment="Center" />
                                    <Border Classes="badge" IsVisible="{Binding IsDisabled}">
                                        <TextBlock Text="停用" Foreground="{DynamicResource SemiColorDanger}" />
                                    </Border>
                                </StackPanel>
                            </TreeDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </Grid>
            </Border>

            <!-- 中（映射草稿）：① 在树上选中的范围内按层级勾选位置 → ② 在右边勾选通道 → ③ 组装成配对，逐行校验、调整 → 确认 -->
            <Border Grid.Column="1" Classes="panel" Padding="20,16" IsVisible="{Binding IsDraftMode}">
                <Grid RowDefinitions="Auto,Auto,*" RowSpacing="12" DataContext="{Binding Draft}" x:DataType="vm:MappingDraftViewModel">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <PathIcon Data="{DynamicResource SemiIconBranch}" Width="14" Height="14"
                                  Foreground="{DynamicResource SemiColorPrimary}" />
                        <TextBlock Classes="section" Text="映射草稿" />
                    </StackPanel>
                    <Border Grid.Row="1" Height="1" Background="{DynamicResource SemiColorBorder}" />

                    <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="12" Margin="0,0,12,0">

                            <!-- ① 取位置 -->
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <TextBlock Text="范围" VerticalAlignment="Center" Foreground="{DynamicResource SemiColorText1}" />
                                <TextBlock Grid.Column="1" Text="{Binding ScopeText, TargetNullValue='请在左边选择位置'}" FontWeight="SemiBold"
                                           VerticalAlignment="Center" Foreground="{DynamicResource SemiColorText0}" />
                            </Grid>
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                <ComboBox Grid.Column="0" HorizontalAlignment="Stretch" AutomationProperties.Name="接线层级"
                                          ItemsSource="{Binding LevelOptions}" SelectedItem="{Binding SelectedLevel}" />
                                <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" AutomationProperties.Name="位置筛选"
                                          ItemsSource="{Binding FilterOptions}" SelectedItem="{Binding Filter}" />
                            </Grid>
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
                                    <Button Content="全选" Padding="10,2" Command="{Binding SelectAllPositionsCommand}" />
                                    <Button Content="清空" Padding="10,2" Command="{Binding ClearPositionsCommand}" />
                                </StackPanel>
                                <TextBlock Text="{Binding PositionCountText}" VerticalAlignment="Center"
                                           Foreground="{DynamicResource SemiColorText1}" />
                            </DockPanel>
                            <ListBox ItemsSource="{Binding Positions}" MaxHeight="220" Background="Transparent"
                                     BorderBrush="{DynamicResource SemiColorBorder}" BorderThickness="1">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:DraftPositionViewModel">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <CheckBox IsChecked="{Binding IsChecked}" AutomationProperties.Name="选择位置" />
                                            <TextBlock Text="{Binding Text}" VerticalAlignment="Center" FontFamily="Consolas, monospace" />
                                            <Border Classes="badge" IsVisible="{Binding IsDisabled}">
                                                <TextBlock Text="停用" Foreground="{DynamicResource SemiColorDanger}" />
                                            </Border>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- ② 取通道在右边勾选；③ 组装 -->
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Classes="Primary" Theme="{DynamicResource SolidButton}"
                                        Content="组装" MinWidth="72" Command="{Binding AssembleCommand}" />
                                <TextBlock Text="{Binding ChannelCountText}" VerticalAlignment="Center"
                                           Foreground="{DynamicResource SemiColorText1}" />
                            </DockPanel>
                            <Border Height="1" Background="{DynamicResource SemiColorBorder}" IsVisible="{Binding HasRows}" />

                            <!-- 配对预览：位置顺序不变，上移 / 下移在相邻两行之间交换通道；有问题的行直接标出原因 -->
                            <ItemsControl ItemsSource="{Binding Rows}" IsVisible="{Binding HasRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:DraftRowViewModel">
                                        <Border BorderBrush="{DynamicResource SemiColorBorder}" BorderThickness="0,0,0,1" Padding="0,6">
                                            <StackPanel Spacing="4">
                                                <DockPanel>
                                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4">
                                                        <Button Content="上移" Padding="6,2" Command="{Binding MoveUpCommand}" />
                                                        <Button Content="下移" Padding="6,2" Command="{Binding MoveDownCommand}" />
                                                        <Button Content="移除" Padding="6,2" Classes="Danger" Command="{Binding RemoveCommand}" />
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding PositionText}" FontWeight="SemiBold" VerticalAlignment="Center"
                                                               FontFamily="Consolas, monospace" Foreground="{DynamicResource SemiColorText0}" />
                                                </DockPanel>
                                                <Grid ColumnDefinitions="*,120" ColumnSpacing="8">
                                                    <TextBlock Grid.Column="0" Text="{Binding ChannelText}" TextWrapping="Wrap" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource SemiColorText1}" />
                                                    <TextBox Grid.Column="1" Text="{Binding Purpose}" PlaceholderText="用途"
                                                             AutomationProperties.Name="用途" MaxLength="{Binding MaxPurposeLength}" />
                                                </Grid>
                                                <TextBlock Text="{Binding Problem}" IsVisible="{Binding HasProblem}" TextWrapping="Wrap"
                                                           Foreground="{DynamicResource SemiColorDanger}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Classes="message" Classes.error="{Binding IsError}" IsVisible="{Binding HasMessage}" Text="{Binding Message}" />

                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" IsVisible="{Binding HasRows}">
                                <Button Content="清空草稿" Command="{Binding ClearCommand}" />
                                <Button Classes="Primary" Theme="{DynamicResource SolidButton}" Content="确认映射" Command="{Binding ConfirmCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- 中（按位置查看）：选中位置的接线（上级继承的在前）；批量接线、修改、拆除、命令 -->
            <Border Grid.Column="1" Classes="panel" Padding="20,16" IsVisible="{Binding IsWiringMode}">
                <Grid RowDefinitions="Auto,Auto,*" RowSpacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <PathIcon Data="{DynamicResource SemiIconBranch}" Width="14" Height="14"
                                  Foreground="{DynamicResource SemiColorPrimary}" />
                        <TextBlock Classes="section" Text="{Binding SelectedTitle, FallbackValue='请选择位置', TargetNullValue='请选择位置'}" />
                    </StackPanel>
                    <Border Grid.Row="1" Height="1" Background="{DynamicResource SemiColorBorder}" />
                    <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <views:WiringPanel DataContext="{Binding Wiring}" Margin="0,0,12,0" />
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- 右：总线上可映射的硬件通道。选中位置后点"关联"即把这路通道接到该位置；已映射的点"定位"跳到它的位置 -->
            <Border Grid.Column="2" Classes="panel" Padding="20,16">
                <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" RowSpacing="12">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
                            <Button Content="勾选可见" Padding="10,2" IsVisible="{Binding IsDraftMode}"
                                    Command="{Binding SelectVisibleChannelsCommand}" />
                            <Button Content="清空勾选" Padding="10,2" IsVisible="{Binding IsDraftMode}"
                                    Command="{Binding ClearChannelsCommand}" />
                            <CheckBox Content="只看未映射" IsChecked="{Binding UnmappedOnly}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PathIcon Data="{DynamicResource SemiIconLink}" Width="14" Height="14"
                                      Foreground="{DynamicResource SemiColorPrimary}" />
                            <TextBlock Classes="section" Text="硬件通道" />
                        </StackPanel>
                    </DockPanel>
                    <Border Grid.Row="1" Height="1" Background="{DynamicResource SemiColorBorder}" />

                    <Grid Grid.Row="2" ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <TextBlock Grid.Column="0" Text="关联用途" VerticalAlignment="Center"
                                   Foreground="{DynamicResource SemiColorText1}" />
                        <TextBox Grid.Column="1" AutomationProperties.Name="关联用途" PlaceholderText="如 VBAT"
                                 MaxLength="{Binding MaxPurposeLength}" Text="{Binding PurposeInput}" />
                    </Grid>

                    <TextBlock Grid.Row="3" Classes="message" Classes.error="{Binding IsError}"
                               IsVisible="{Binding HasMessage}" Text="{Binding Message}" />

                    <TextBlock Grid.Row="4" Text="没有可映射的通道：请先在总线监控的模块配置里添加模块并启用通道"
                               TextWrapping="Wrap" Foreground="{DynamicResource SemiColorText1}"
                               IsVisible="{Binding HasNoHardware}" />

                    <ListBox Grid.Row="4" Classes="hardware" ItemsSource="{Binding Hardware}" IsVisible="{Binding HasHardware}"
                             Background="Transparent">
                        <ListBox.DataTemplates>
                            <DataTemplate DataType="vm:MappingModuleViewModel">
                                <TextBlock Text="{Binding Header}" FontWeight="SemiBold" Margin="4,14,4,6"
                                           Foreground="{DynamicResource SemiColorText0}" />
                            </DataTemplate>
                            <DataTemplate DataType="vm:MappingChannelViewModel">
                                <!-- 映射草稿模式下通道前面有勾选框（取通道；已映射的也能再接到别的位置） -->
                                <DockPanel Margin="16,6,4,6">
                                <CheckBox DockPanel.Dock="Left" Margin="0,0,8,0" IsVisible="{Binding ShowCheckBox}"
                                          IsChecked="{Binding IsChecked}" AutomationProperties.Name="选择通道" />
                                <Grid ColumnDefinitions="1.2*,56,1.6*,Auto" ColumnSpacing="12">
                                    <TextBlock Grid.Column="0" Text="{Binding NameText}" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding NameText}"
                                               Foreground="{DynamicResource SemiColorText0}" />
                                    <TextBlock Grid.Column="1" Text="{Binding KindText}" VerticalAlignment="Center"
                                               Foreground="{DynamicResource SemiColorText1}" />
                                    <TextBlock Grid.Column="2" Text="{Binding MappedText}" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding MappedText}"
                                               Foreground="{DynamicResource SemiColorText1}" />
                                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6">
                                        <Button Content="关联" Padding="10,2" Classes="Primary"
                                                Command="{Binding MapCommand}" />
                                        <Button Content="定位" Padding="10,2"
                                                IsVisible="{Binding IsMapped}" Command="{Binding LocateCommand}" />
                                    </StackPanel>
                                </Grid>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.DataTemplates>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
