<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Solve.UI.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="760"
             x:Class="Solve.UI.Views.TopologyView"
             x:DataType="vm:TopologyViewModel"
             x:CompileBindings="True"
             Background="#0D000000">
    <!-- 页面底色、卡片与提示框样式沿用系统设置页。编译期绑定：属性名写错在构建时报错，而不是运行时静默失效 -->

    <Design.DataContext>
        <vm:TopologyViewModel />
    </Design.DataContext>

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <BoxShadows x:Key="ConsolePanelShadow">0 4 16 0 #14000000, 0 0 1 0 #33000000</BoxShadows>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <BoxShadows x:Key="ConsolePanelShadow">0 4 16 0 #66000000, 0 0 0 1 #1AFFFFFF</BoxShadows>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="Border.panel">
            <Setter Property="Background" Value="{DynamicResource SemiColorBackground1}" />
            <Setter Property="CornerRadius" Value="{DynamicResource SemiBorderRadiusLarge}" />
            <Setter Property="BoxShadow" Value="{DynamicResource ConsolePanelShadow}" />
        </Style>
        <Style Selector="TextBlock.label">
            <Setter Property="Foreground" Value="{DynamicResource SemiColorText1}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.section">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource SemiColorText0}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.muted">
            <Setter Property="Foreground" Value="{DynamicResource SemiColorText2}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <!-- 必须排在 .muted 之后以覆盖其前景色 -->
        <Style Selector="TextBlock.error">
            <Setter Property="Foreground" Value="{DynamicResource SemiColorDanger}" />
        </Style>
        <Style Selector="Border.notice">
            <Setter Property="Background" Value="{DynamicResource SemiColorWarningLight}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SemiColorWarning}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource SemiBorderRadiusMedium}" />
            <Setter Property="Padding" Value="12,10" />
        </Style>
        <!-- 必须排在 .notice 之后以覆盖其配色 -->
        <Style Selector="Border.notice.danger">
            <Setter Property="Background" Value="{DynamicResource SemiColorDangerLight}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SemiColorDanger}" />
        </Style>
        <Style Selector="NumericUpDown.count">
            <Setter Property="Width" Value="128" />
            <Setter Property="Increment" Value="1" />
            <Setter Property="FormatString" Value="0" />
            <Setter Property="ParsingNumberStyle" Value="Integer" />
            <Setter Property="ClipValueToMinMax" Value="True" />
        </Style>
        <!-- 节点详情：左列标签，右列值；Id 用只读文本框，便于选中复制 -->
        <Style Selector="TextBlock.value">
            <Setter Property="Foreground" Value="{DynamicResource SemiColorText0}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="Border.badge">
            <Setter Property="Background" Value="{DynamicResource SemiColorDangerLight}" />
            <Setter Property="CornerRadius" Value="{DynamicResource SemiBorderRadiusSmall}" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Styles>

    <Grid Margin="20" RowDefinitions="Auto,*" RowSpacing="20">

      <!-- StackPanel 只在可见的子元素之间留间距：提示区为空时不会多出一道空隙 -->
      <StackPanel Grid.Row="0" Spacing="20">

        <!-- 页面标题与建档（建档后结构改在下方节点详情中逐个编辑，不再提供整机布局保存） -->
        <Border Classes="panel" Padding="20,10">
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right"
                        Classes="Primary" Theme="{DynamicResource SolidButton}"
                        Content="建档"
                        MinWidth="72"
                        IsVisible="{Binding !IsConfigured}"
                        Command="{Binding SaveCommand}"
                        ToolTip.Tip="按「设备布局」一次生成全部节点；建档后在下方节点详情中逐个增删下级" />
                <TextBlock Text="{Binding PageTitle}"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource SemiColorText0}"
                           VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <!-- 提示区：建档、节点设置、结构编辑共用。会删除位置、解除停用、新增即启用或改变位置编码时列出影响，确认后才保存；
             确认前改动对应的输入（或换选节点）会取消这次保存 -->
        <StackPanel Spacing="12" IsVisible="{Binding HasPageNotice}">
            <Border Classes="notice danger" IsVisible="{Binding IsAwaitingConfirmation}">
                <StackPanel Spacing="10">
                    <TextBlock Text="{Binding PendingConfirmationText}"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource SemiColorText0}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Classes="Danger" Theme="{DynamicResource SolidButton}"
                                Content="确认并保存"
                                Command="{Binding ConfirmCommand}" />
                        <Button Content="取消" Command="{Binding CancelCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Classes="panel" Padding="20,10" IsVisible="{Binding HasSaveMessage}">
                <TextBlock Classes="muted"
                           Classes.error="{Binding IsSaveError}"
                           Text="{Binding SaveMessage}" />
            </Border>
        </StackPanel>

        <!-- 设备布局：尚未建档时按统一布局一次生成；建档后只显示各层数量 -->
        <Border Classes="panel" Padding="20,16">
            <StackPanel Spacing="12">

                <DockPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <PathIcon Data="{DynamicResource SemiIconComponent}" Width="14" Height="14"
                                  Foreground="{DynamicResource SemiColorPrimary}" />
                        <TextBlock Classes="section" Text="设备布局" />
                        <TextBlock Classes="muted" VerticalAlignment="Center" Margin="8,0,0,0"
                                   Text="{Binding SummaryText}" />
                    </StackPanel>
                </DockPanel>
                <Border Height="1" Background="{DynamicResource SemiColorBorder}" />

                <!-- 读取失败：禁止保存，提供重试 -->
                <Border Classes="notice danger" IsVisible="{Binding HasLoadError}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="{Binding LoadErrorText}"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource SemiColorText0}" />
                        <Button Content="重新读取" HorizontalAlignment="Left" Command="{Binding ReloadCommand}" />
                    </StackPanel>
                </Border>

                <TextBlock Classes="muted" IsVisible="{Binding IsConfigured}"
                           Text="已建档：在下方节点浏览中选中节点，可新增下级、修改序号、复制或删除，每个节点的下级数量可以不同；选中系统根可修改系统名称" />

                <!-- 首次建档的统一布局 -->
                <StackPanel Spacing="12" IsVisible="{Binding !IsConfigured}">
                    <Grid ColumnDefinitions="88,*" ColumnSpacing="12">
                        <TextBlock Grid.Column="0" Classes="label" Text="系统名称" />
                        <TextBox Grid.Column="1"
                                 AutomationProperties.Name="系统名称"
                                 MaxWidth="420" HorizontalAlignment="Left" MinWidth="260"
                                 PlaceholderText="如 老化房 1#"
                                 Text="{Binding SystemNameInput}"
                                 IsEnabled="{Binding IsInputEnabled}" />
                    </Grid>

                    <!-- 五层数量：系统之下自上而下 -->
                    <WrapPanel ItemSpacing="28" LineSpacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Classes="label" Text="柜体数" />
                            <NumericUpDown Classes="count" Value="{Binding CabinetsInput}" AutomationProperties.Name="柜体数"
                                           Minimum="{Binding MinCount}" Maximum="{Binding MaxCount}"
                                           IsEnabled="{Binding IsInputEnabled}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Classes="label" Text="每柜层位" />
                            <NumericUpDown Classes="count" Value="{Binding LayersPerCabinetInput}" AutomationProperties.Name="每柜层位"
                                           Minimum="{Binding MinCount}" Maximum="{Binding MaxCount}"
                                           IsEnabled="{Binding IsInputEnabled}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Classes="label" Text="每层槽位" />
                            <NumericUpDown Classes="count" Value="{Binding SlotsPerLayerInput}" AutomationProperties.Name="每层槽位"
                                           Minimum="{Binding MinCount}" Maximum="{Binding MaxCount}"
                                           IsEnabled="{Binding IsInputEnabled}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Classes="label" Text="每槽治具位" />
                            <NumericUpDown Classes="count" Value="{Binding FixturesPerSlotInput}" AutomationProperties.Name="每槽治具位"
                                           Minimum="{Binding MinCount}" Maximum="{Binding MaxCount}"
                                           IsEnabled="{Binding IsInputEnabled}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Classes="label" Text="每治具产品位" />
                            <NumericUpDown Classes="count" Value="{Binding ProductsPerFixtureInput}" AutomationProperties.Name="每治具产品位"
                                           Minimum="{Binding MinCount}" Maximum="{Binding MaxCount}"
                                           IsEnabled="{Binding IsInputEnabled}" />
                        </StackPanel>
                    </WrapPanel>

                    <TextBlock Classes="muted"
                               Classes.error="{Binding IsLayoutPreviewError}"
                               Text="{Binding LayoutPreviewText}" />
                </StackPanel>
            </StackPanel>
        </Border>
      </StackPanel>

        <!-- 节点浏览：左侧树按需展开，右侧显示选中节点的两套身份，并可改名、停用 -->
        <Border Grid.Row="1" Classes="panel" Padding="20,16">
            <Grid RowDefinitions="Auto,Auto,*" RowSpacing="12">
                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
                    <PathIcon Data="{DynamicResource SemiIconBranch}" Width="14" Height="14"
                              Foreground="{DynamicResource SemiColorPrimary}" />
                    <TextBlock Classes="section" Text="节点浏览" />
                    <TextBlock Classes="muted" VerticalAlignment="Center" Margin="8,0,0,0"
                               Text="系统按 Id 识别节点；位置编码与名称给人看" />
                </StackPanel>
                <Border Grid.Row="1" Height="1" Background="{DynamicResource SemiColorBorder}" />

                <TextBlock Grid.Row="2" Classes="muted"
                           IsVisible="{Binding !IsConfigured}"
                           Text="尚未建档，保存布局后在这里浏览全部节点" />

                <!-- 详情栏宽度要放得下完整的 36 位 Id（等宽字体），否则复制前看不全 -->
                <Grid Grid.Row="2" ColumnDefinitions="*,460" ColumnSpacing="20"
                      IsVisible="{Binding IsConfigured}">
                    <TreeView Grid.Column="0"
                              ItemsSource="{Binding Roots}"
                              SelectedItem="{Binding SelectedItem, Mode=TwoWay}">
                        <!-- 展开状态按节点 Id 记在视图模型里：保存后树重建，展开过的节点保持展开 -->
                        <TreeView.Styles>
                            <Style Selector="TreeViewItem" x:DataType="vm:TopologyTreeItemViewModel">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                            </Style>
                        </TreeView.Styles>
                        <TreeView.ItemTemplate>
                            <TreeDataTemplate x:DataType="vm:TopologyTreeItemViewModel" ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{Binding Header}" VerticalAlignment="Center" />
                                    <TextBlock Classes="muted" Text="{Binding Name}" IsVisible="{Binding HasName}"
                                               VerticalAlignment="Center" />
                                    <Border Classes="badge" IsVisible="{Binding IsDisabled}">
                                        <TextBlock Text="停用" FontSize="11"
                                                   Foreground="{DynamicResource SemiColorDanger}" />
                                    </Border>
                                </StackPanel>
                            </TreeDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>

                    <Border Grid.Column="1"
                            BorderBrush="{DynamicResource SemiColorBorder}" BorderThickness="1,0,0,0"
                            Padding="20,0,0,0">
                      <!-- 结构编辑区较高：详情栏单独滚动，不挤压左侧的树 -->
                      <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <Grid IsVisible="{Binding HasSelection}"
                              ColumnDefinitions="72,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                              ColumnSpacing="12" RowSpacing="12" VerticalAlignment="Top" Margin="0,0,12,0">
                            <TextBlock Grid.Row="0" Grid.Column="0" Classes="label" Text="层级" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Classes="value" Text="{Binding SelectedLevelText}" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Classes="label" Text="位置编码" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Classes="value" FontFamily="Consolas, monospace"
                                       Text="{Binding SelectedAddressText}" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Classes="label" Text="节点 Id" />
                            <TextBox Grid.Row="2" Grid.Column="1" IsReadOnly="True" FontFamily="Consolas, monospace"
                                     AutomationProperties.Name="节点 Id"
                                     Text="{Binding SelectedIdText, Mode=OneWay}"
                                     ToolTip.Tip="系统内部只认这个 Id，终身不变；可选中复制" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Classes="label" Text="状态" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Classes="value" Text="{Binding SelectedStatusText}" />

                            <TextBlock Grid.Row="4" Grid.Column="0" Classes="label" Text="下级" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Classes="value" Text="{Binding SelectedChildrenText}" />

                            <!-- 编辑：名称（人用）与启用状态；Id 不可修改，位置编码在下方「结构」中改序号 -->
                            <Border Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2"
                                    Height="1" Background="{DynamicResource SemiColorBorder}" />

                            <TextBlock Grid.Row="6" Grid.Column="0" Classes="label" Text="名称" />
                            <TextBox Grid.Row="6" Grid.Column="1"
                                     AutomationProperties.Name="节点名称"
                                     PlaceholderText="{Binding NodeNamePlaceholder}"
                                     Text="{Binding NodeNameInput}"
                                     IsEnabled="{Binding IsNodeInputEnabled}" />

                            <StackPanel Grid.Row="7" Grid.Column="1" Spacing="10">
                                <CheckBox Content="启用（停用后它和全部下级都不再接受命令）"
                                          IsChecked="{Binding NodeEnabledInput}"
                                          IsEnabled="{Binding IsNodeEnabledInputEnabled}" />
                                <TextBlock Classes="muted" IsVisible="{Binding HasNodeEditHint}" Text="{Binding NodeEditHint}" />
                                <Button Classes="Primary" Theme="{DynamicResource SolidButton}"
                                        HorizontalAlignment="Left"
                                        Content="保存节点"
                                        Command="{Binding SaveNodeCommand}"
                                        ToolTip.Tip="保存这个节点的名称与启用状态；重新启用时先请你确认" />
                            </StackPanel>

                            <!-- 结构：每次操作单独保存；删除、改序号、新增即启用都要先确认 -->
                            <Border Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="2"
                                    Height="1" Background="{DynamicResource SemiColorBorder}"
                                    IsVisible="{Binding IsStructureEditable}" />

                            <!-- 新增下级：数量 + 每个新节点下各层的数量（预填同级第一个节点的结构） -->
                            <TextBlock Grid.Row="9" Grid.Column="0" Classes="label" Text="新增下级"
                                       VerticalAlignment="Top" Margin="0,6,0,0"
                                       IsVisible="{Binding CanAddChildren}" />
                            <StackPanel Grid.Row="9" Grid.Column="1" Spacing="10"
                                        IsVisible="{Binding CanAddChildren}"
                                        IsEnabled="{Binding IsStructureInputEnabled}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <NumericUpDown Classes="count" Width="96"
                                                   AutomationProperties.Name="新增数量"
                                                   Value="{Binding AddCountInput}"
                                                   Minimum="{Binding MinCount}" Maximum="{Binding MaxCount}" />
                                    <TextBlock Classes="label" Text="{Binding AddChildLevelText}" />
                                </StackPanel>
                                <ItemsControl ItemsSource="{Binding AddTemplateInputs}" IsVisible="{Binding HasAddTemplate}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel ItemSpacing="16" LineSpacing="8" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:TopologyTemplateInputViewModel">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Classes="label" Text="{Binding Label}" />
                                                <NumericUpDown Classes="count" Width="96"
                                                               AutomationProperties.Name="{Binding Label}"
                                                               Value="{Binding Value}"
                                                               Minimum="1" Maximum="999" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Classes="muted"
                                           Classes.error="{Binding IsAddPreviewError}"
                                           Text="{Binding AddPreviewText}" />
                                <Button HorizontalAlignment="Left"
                                        Content="新增"
                                        Command="{Binding AddChildrenCommand}"
                                        ToolTip.Tip="序号接在现有最大序号之后，不回填中间的空号" />
                            </StackPanel>

                            <!-- 修改序号：位置编码随之改变，Id 不变 -->
                            <TextBlock Grid.Row="10" Grid.Column="0" Classes="label" Text="序号"
                                       IsVisible="{Binding CanEditPosition}" />
                            <StackPanel Grid.Row="10" Grid.Column="1" Orientation="Horizontal" Spacing="8"
                                        IsVisible="{Binding CanEditPosition}"
                                        IsEnabled="{Binding IsStructureInputEnabled}">
                                <NumericUpDown Classes="count" Width="96"
                                               AutomationProperties.Name="序号"
                                               Value="{Binding OrdinalInput}"
                                               Minimum="{Binding MinCount}" Maximum="{Binding MaxCount}" />
                                <Button Content="修改序号"
                                        Command="{Binding RenumberCommand}"
                                        ToolTip.Tip="它和全部下级的位置编码都会改变，Id 不变；保存前先请你确认，现场标牌需同步更换" />
                            </StackPanel>

                            <!-- 复制与删除 -->
                            <StackPanel Grid.Row="11" Grid.Column="1" Spacing="8"
                                        IsVisible="{Binding CanEditPosition}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="复制为同级"
                                            Command="{Binding CopyCommand}"
                                            ToolTip.Tip="连同全部下级复制到同级现有最大序号之后，副本全部分配新 Id" />
                                    <Button Classes="Danger"
                                            Content="删除"
                                            Command="{Binding RemoveCommand}"
                                            ToolTip.Tip="连同全部下级一起删除；保存前先请你确认" />
                                </StackPanel>
                                <TextBlock Classes="muted" Text="{Binding RemoveHintText}" />
                            </StackPanel>

                            <!-- 新位置的启用状态：新增与复制共用，默认停用（故障安全） -->
                            <TextBlock Grid.Row="12" Grid.Column="0" Classes="label" Text="新位置"
                                       IsVisible="{Binding IsStructureEditable}" />
                            <CheckBox Grid.Row="12" Grid.Column="1"
                                      Content="新增与复制出的位置立即启用"
                                      IsChecked="{Binding NewPositionsEnabledInput}"
                                      IsEnabled="{Binding IsStructureInputEnabled}"
                                      IsVisible="{Binding IsStructureEditable}" />
                            <TextBlock Grid.Row="13" Grid.Column="1" Classes="muted"
                                       IsVisible="{Binding IsStructureEditable}"
                                       Text="默认停用：现场安装调试完成后，再在上方逐个启用；勾选后保存前需要确认" />
                        </Grid>
                      </ScrollViewer>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
